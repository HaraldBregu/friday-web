---
import Layout from "./Layout.astro";
import Icon from "../components/Icon.astro";

const { post, readingTime, slug = post.id.replace(/\.mdx?$/, "") } = Astro.props;
---

<Layout title={post.data.title} description={post.data.description} canonical={`/blog/${slug}`}>
  <article class="article shell article-shell">
    <a class="back-link" href="/blog">
      <Icon name="ArrowRight" size={16} />
      Back to blog
    </a>
    <header class="article-header">
      <p class="eyebrow">{post.data.author} / {readingTime} min read</p>
      <h1>{post.data.title}</h1>
      <p>{post.data.description}</p>
      <div class="post-meta">
        <time datetime={post.data.pubDate.toISOString()}>
          {
            post.data.pubDate.toLocaleDateString("en", {
              month: "long",
              day: "numeric",
              year: "numeric",
            })
          }
        </time>
        <span>{post.data.tags.join(", ")}</span>
      </div>
    </header>
    <div class="article-body">
      <slot />
    </div>
  </article>
</Layout>
