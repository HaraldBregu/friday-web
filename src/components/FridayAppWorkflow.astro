---
import Icon from "./Icon.astro";

const activities = [
  { label: "Using skill", detail: "release-brief", icon: "Sparkles" },
  { label: "Searching knowledge", detail: "8 relevant excerpts", icon: "Search" },
  { label: "Reading wiki page", detail: "[[Release readiness]]", icon: "BookOpen" },
  { label: "Updating local file", detail: "docs/release.md", icon: "TerminalSquare" },
];
---

<div class="fr-app" role="img" aria-label="Friday desktop conversation showing a request loading a skill, searching the Knowledge Base, reading an LLM Wiki page, and updating a local file">
  <div class="fr-app__titlebar">
    <div class="fr-window-dots" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="fr-app__title">
      <img src="/icon-rounded.png" width="18" height="18" alt="" />
      <span>Friday</span>
    </div>
    <div class="fr-app__title-actions" aria-hidden="true"><span></span><span></span></div>
  </div>

  <div class="fr-app__body">
    <aside class="fr-app__sidebar" aria-hidden="true">
      <div class="fr-app__new"><Icon name="Plus" size={15} /><span>New chat</span></div>
      <div class="fr-app__nav-item is-active"><Icon name="MessageSquare" size={15} /><span>Chats</span></div>
      <div class="fr-app__nav-item"><Icon name="Layers" size={15} /><span>Extensions</span></div>
      <div class="fr-app__history">
        <small>Today</small>
        <span>Prepare the release brief</span>
        <span>Review research notes</span>
      </div>
      <div class="fr-app__settings"><Icon name="Cpu" size={15} /><span>Settings</span></div>
    </aside>

    <div class="fr-app__conversation">
      <div class="fr-app__conversation-head">
        <div><strong>Prepare the release brief</strong><small>Friday · working locally</small></div>
        <span class="fr-model-pill">Assistant model <Icon name="ChevronDown" size={12} /></span>
      </div>

      <div class="fr-thread">
        <div class="fr-user-message">
          Use our release workflow and source material to update the launch brief.
        </div>

        <article class="fr-agent-message">
          <div class="fr-agent-message__identity">
            <img src="/icon-rounded.png" width="22" height="22" alt="" />
            <strong>Friday</strong>
          </div>
          <p>I’ll ground the update in your indexed notes and compiled project knowledge.</p>
          <div class="fr-activity-list">
            {activities.map((activity, index) => (
              <div class="fr-activity" style={`--activity-index:${index}`}>
                <span class="fr-activity__status"><Icon name="Check" size={12} /></span>
                <span class="fr-activity__icon"><Icon name={activity.icon} size={14} /></span>
                <strong>{activity.label}</strong>
                <code>{activity.detail}</code>
              </div>
            ))}
          </div>
          <div class="fr-agent-result">
            <span><Icon name="CheckCircle2" size={15} /> Complete</span>
            <p>Updated the launch brief with sourced decisions, open questions, and next steps.</p>
          </div>
        </article>
      </div>

      <div class="fr-composer" aria-hidden="true">
        <span>Ask Friday to do something…</span>
        <div><Icon name="Plus" size={17} /><Icon name="Mic" size={17} /><b><Icon name="ArrowUp" size={15} /></b></div>
      </div>
    </div>
  </div>
</div>
