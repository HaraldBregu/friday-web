---
import Icon from "./Icon.astro";
import { getLocaleContent, normalizeLocale, type Locale } from "../i18n";

interface Props {
  locale?: Locale;
}

const locale = normalizeLocale(Astro.props.locale);
const { productMockup } = getLocaleContent(locale);
const navItems = productMockup.navItems;
const planItems = productMockup.planItems;
---

<div class="product-window" aria-label={productMockup.windowLabel}>
  <div class="product-window__bar">
    <div class="window-lights" aria-hidden="true">
      <span class="window-lights__red"></span>
      <span class="window-lights__yellow"></span>
      <span></span>
    </div>
    <strong>{productMockup.titlebarRoute}</strong>
    <div class="product-window__command" aria-label={productMockup.commandMenuLabel}>
      <Icon name="Search" size={14} />
      <span>{productMockup.commandMenuLabel}</span>
      <kbd>{productMockup.commandShortcut}</kbd>
    </div>
    <span class="window-status">{productMockup.localWorkspace}</span>
  </div>

  <div class="product-window__body">
    <aside class="product-window__nav" aria-label={productMockup.appAreasLabel}>
      <div class="product-window__nav-head">
        <span class="brand-mark brand-mark--small" aria-hidden="true"></span>
        <strong>Friday</strong>
      </div>
      {
        navItems.map((item) => (
          <span class={item.active ? "is-active" : ""}>
            <Icon name={item.icon} size={16} />
            {item.label}
          </span>
        ))
      }
    </aside>

    <section class="product-window__main" aria-label={productMockup.conversationLabel}>
      <div class="product-window__toolbar">
        <span>
          <Icon name="MessagesSquare" size={15} />
          {productMockup.titlebarRoute}
        </span>
        <span class="window-state">
          <span aria-hidden="true"></span>
          {productMockup.statusReady}
        </span>
      </div>

      <div class="product-window__chat">
        <div class="chat-bubble chat-bubble--user">
          {productMockup.userMessage}
        </div>

        <article class="assistant-message">
          <div class="assistant-row">
            <div class="assistant-mark">
              <Icon name="Bot" size={17} />
            </div>
            <div>
              <strong>Friday</strong>
              <span>{productMockup.assistantStatus}</span>
            </div>
          </div>

          <div class="assistant-plan">
            {planItems.map((item) => <span>{item}</span>)}
          </div>

          <div class="activity-panel">
            <span>
              <Icon name="TerminalSquare" size={14} />
              {productMockup.toolActivityLabel}
            </span>
            <strong>{productMockup.toolActivityValue}</strong>
          </div>
        </article>

        <div class="tool-request">
          <div>
            <span>{productMockup.toolRequest}</span>
            <strong>{productMockup.toolCommand}</strong>
          </div>
          <button type="button">
            <Icon name="CheckCircle2" size={16} />
            {productMockup.approve}
          </button>
        </div>
      </div>

      <div class="product-window__composer" aria-label={productMockup.composerLabel}>
        <button aria-label={productMockup.addAttachment} type="button">
          <Icon name="Plus" size={18} />
        </button>
        <span>{productMockup.composerPlaceholder}</span>
        <button aria-label={productMockup.voiceInput} type="button">
          <Icon name="Mic" size={18} />
        </button>
        <button aria-label={productMockup.sendPrompt} class="composer-send" type="button">
          <Icon name="ArrowRight" size={18} />
        </button>
      </div>
    </section>

    <aside class="product-window__rail" aria-label={productMockup.actionPreviewLabel}>
      <div class="rail-section">
        <p>{productMockup.settingsLabel}</p>
        <article>
          <Icon name="Bot" size={18} />
          <span>{productMockup.modelLabel}</span>
          <strong>{productMockup.modelValue}</strong>
        </article>
        <article>
          <Icon name="Mic" size={18} />
          <span>{productMockup.voiceLabel}</span>
          <strong>{productMockup.voiceValue}</strong>
        </article>
      </div>
      <div class="rail-section">
        <p>{productMockup.activityLabel}</p>
        <article>
          <Icon name="Clock" size={18} />
          <span>{productMockup.scheduledLabel}</span>
          <strong>{productMockup.scheduledValue}</strong>
        </article>
      </div>
      <div class="rail-section">
        <p>{productMockup.contextLabel}</p>
        <article>
          <Icon name="TerminalSquare" size={18} />
          <span>{productMockup.workspaceLabel}</span>
          <strong>{productMockup.workspaceValue}</strong>
        </article>
        <article>
          <Icon name="RadioTower" size={18} />
          <span>{productMockup.channelLabel}</span>
          <strong>{productMockup.channelValue}</strong>
        </article>
        <article>
          <Icon name="ShieldCheck" size={18} />
          <span>{productMockup.privacyLabel}</span>
          <strong>{productMockup.privacyValue}</strong>
        </article>
      </div>
    </aside>
  </div>
</div>
