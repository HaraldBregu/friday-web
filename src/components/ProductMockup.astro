---
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import { getLocaleContent, normalizeLocale, type Locale } from "../i18n";

interface Props {
  locale?: Locale;
  landingWorkflow?: boolean;
}

const locale = normalizeLocale(Astro.props.locale);
const landingWorkflow = Astro.props.landingWorkflow ?? false;
const { productMockup } = getLocaleContent(locale);
const imagesByFile = Object.fromEntries(
  Object.entries(import.meta.glob<{ default: ImageMetadata }>("../assets/library/*.jpeg", { eager: true })).map(
    ([path, mod]) => [path.split("/").pop() ?? path, mod.default],
  ),
);
---

<div
  class="product-window"
  aria-label={productMockup.windowLabel}
  data-demo-window
  data-attachment-name={productMockup.attachedFile}
  data-dictation-text={productMockup.dictationText}
  data-listening-label={productMockup.listeningLabel}
  data-reply={productMockup.interactiveReply}
>
  <div class="product-window__bar">
    <div class="window-lights" aria-hidden="true">
      <span class="window-lights__red"></span>
      <span class="window-lights__yellow"></span>
      <span></span>
    </div>
    <strong>Friday</strong>
    <div class="product-window__bar-actions">
      <button class="product-window__icon-btn" type="button" aria-label={productMockup.profileLabel}>
        <Icon name="UserRound" size={19} />
      </button>
      <button class="product-window__icon-btn" type="button" aria-label={productMockup.historyLabel}>
        <Icon name="History" size={19} />
      </button>
    </div>
  </div>

  <div class="product-window__body">
    <div class="product-window__thread" aria-label={productMockup.conversationLabel} data-demo-thread>
      {
        landingWorkflow ? (
          <>
            <div class="chat-bubble chat-bubble--user">
              Use our release workflow and source material to update the launch brief.
            </div>
            <article class="assistant-turn">
              <div class="assistant-row">
                <span class="assistant-avatar" aria-hidden="true" />
                <strong>Friday</strong>
              </div>
              <div class="chat-bubble chat-bubble--assistant">
                I’ll ground the update in your indexed notes and compiled project knowledge.
              </div>
              <div class="product-activity" aria-label="Friday tool activity">
                <div><span><Icon name="Sparkles" size={15} /></span><strong>Using skill</strong><code>release-brief</code><Icon name="Check" size={14} /></div>
                <div><span><Icon name="Search" size={15} /></span><strong>Searching knowledge</strong><code>8 excerpts</code><Icon name="Check" size={14} /></div>
                <div><span><Icon name="BookOpen" size={15} /></span><strong>Reading wiki page</strong><code>Release readiness</code><Icon name="Check" size={14} /></div>
                <div><span><Icon name="TerminalSquare" size={15} /></span><strong>Updating local file</strong><code>docs/release.md</code><Icon name="Check" size={14} /></div>
              </div>
              <div class="chat-bubble chat-bubble--assistant">
                Done. I updated the launch brief with sourced decisions, open questions, and next steps.
              </div>
            </article>
          </>
        ) : (
          <>
            <div class="chat-bubble chat-bubble--user chat-bubble--short">
              {productMockup.chatUserGreeting}
            </div>

            <article class="assistant-turn">
              <div class="assistant-row">
                <span class="assistant-avatar" aria-hidden="true"></span>
                <strong>Friday</strong>
              </div>
              <div class="chat-bubble chat-bubble--assistant">
                {productMockup.chatAssistantGreeting}
              </div>
            </article>

            {productMockup.chatMessages.map((message) =>
              message.role === "user" ? (
                <div class="chat-bubble chat-bubble--user">{message.text}</div>
              ) : (
                <article class="assistant-turn">
                  <div class="assistant-row">
                    <span class="assistant-avatar" aria-hidden="true" />
                    <strong>Friday</strong>
                  </div>
                  <div class="chat-bubble chat-bubble--assistant">{message.text}</div>
                </article>
              )
            )}

            {productMockup.libraryFeed.map((item) => {
              const image = imagesByFile[item.file];
              return image ? (
                <>
                  <div class="chat-bubble chat-bubble--user">{item.user}</div>
                  <article class="assistant-turn">
                    <div class="assistant-row">
                      <span class="assistant-avatar" aria-hidden="true" />
                      <strong>Friday</strong>
                    </div>
                    <figure class="chat-image">
                      <figcaption class="chat-image__head">
                        <Icon name="Image" size={15} />
                        <span>{productMockup.imageHeader}</span>
                      </figcaption>
                      <Image alt={item.user} class="chat-image__media" height={400} loading="lazy" src={image} width={640} />
                      <p class="chat-image__caption">{item.reply}</p>
                    </figure>
                  </article>
                </>
              ) : null;
            })}
          </>
        )
      }

    </div>

    <div class="product-window__attachment" data-demo-attachment hidden>
      <Icon name="FolderOpen" size={14} />
      <span>{productMockup.attachedFile}</span>
      <button aria-label={productMockup.removeAttachment} data-demo-remove type="button">
        <Icon name="X" size={13} />
      </button>
    </div>

    <form class="product-window__composer" aria-label={productMockup.composerLabel} data-demo-composer>
      <button aria-label={productMockup.addAttachment} data-demo-attach type="button">
        <Icon name="Plus" size={22} />
      </button>
      <input
        aria-label={productMockup.composerPlaceholder}
        autocomplete="off"
        data-demo-input
        placeholder={productMockup.composerPlaceholder}
        type="text"
      />
      <button aria-label={productMockup.voiceInput} data-demo-voice type="button">
        <Icon name="Mic" size={22} />
      </button>
      <button aria-label={productMockup.sendPrompt} class="composer-send" type="submit">
        <Icon name="AudioLines" size={22} />
      </button>
    </form>
  </div>
</div>

<script is:inline>
  (() => {
    const windows = document.querySelectorAll("[data-demo-window]");

    const appendUserMessage = (thread, text) => {
      const bubble = document.createElement("div");
      bubble.className = "chat-bubble chat-bubble--user";
      bubble.textContent = text;
      thread.append(bubble);
    };

    const appendAssistantMessage = (thread, text) => {
      const turn = document.createElement("article");
      turn.className = "assistant-turn";

      const row = document.createElement("div");
      row.className = "assistant-row";

      const avatar = document.createElement("span");
      avatar.className = "assistant-avatar";
      avatar.setAttribute("aria-hidden", "true");

      const label = document.createElement("strong");
      label.textContent = "Friday";

      const bubble = document.createElement("div");
      bubble.className = "chat-bubble chat-bubble--assistant";
      bubble.textContent = text;

      row.append(avatar, label);
      turn.append(row, bubble);
      thread.append(turn);
    };

    windows.forEach((windowEl) => {
      const thread = windowEl.querySelector("[data-demo-thread]");
      const form = windowEl.querySelector("[data-demo-composer]");
      const input = windowEl.querySelector("[data-demo-input]");
      const attachButton = windowEl.querySelector("[data-demo-attach]");
      const voiceButton = windowEl.querySelector("[data-demo-voice]");
      const attachment = windowEl.querySelector("[data-demo-attachment]");
      const removeAttachment = windowEl.querySelector("[data-demo-remove]");
      if (!thread || !form || !input || !attachButton || !voiceButton || !attachment || !removeAttachment) return;

      const scrollToLatest = () => {
        thread.scrollTop = thread.scrollHeight;
      };

      scrollToLatest();

      form.addEventListener("submit", (event) => {
        event.preventDefault();
        const text = input.value.trim();
        if (!text) return;

        appendUserMessage(thread, text);
        input.value = "";
        attachment.hidden = true;
        scrollToLatest();

        window.setTimeout(() => {
          appendAssistantMessage(thread, windowEl.dataset.reply || "I can help with that. What would you like to do next?");
          scrollToLatest();
        }, 420);
      });

      attachButton.addEventListener("click", () => {
        attachment.hidden = !attachment.hidden;
        input.focus();
      });

      removeAttachment.addEventListener("click", () => {
        attachment.hidden = true;
        input.focus();
      });

      voiceButton.addEventListener("click", () => {
        windowEl.classList.add("is-listening");
        input.placeholder = windowEl.dataset.listeningLabel || "Listening...";

        window.setTimeout(() => {
          input.value = windowEl.dataset.dictationText || "";
          input.placeholder = input.getAttribute("aria-label") || "";
          windowEl.classList.remove("is-listening");
          input.focus();
        }, 850);
      });
    });
  })();
</script>
