---
import Icon from "./Icon.astro";

interface Labels {
  windowLabel: string;
  history: string;
  profile: string;
  request: string;
  copy: string;
  edit: string;
  tool: string;
  tokens: string;
  assetAlt: string;
  play: string;
  pause: string;
  seek: string;
  duration: string;
  volume: string;
  mute: string;
  unmute: string;
  fullscreen: string;
  complete: string;
  composer: string;
  attach: string;
  dictate: string;
  voice: string;
  previousRequests: Array<{
    type: "image" | "sound";
    request: string;
    tool: string;
    result: string;
    meta: string;
    assetAlt?: string;
  }>;
}

interface Props {
  labels: Labels;
}

const { labels } = Astro.props;
---

<section class="fr-showcase" aria-label={labels.windowLabel}>
  <div class="fr-showcase__glow" aria-hidden="true"></div>
  <div class="fr-showcase-app">
    <header class="fr-showcase-app__bar">
      <span class="fr-window-dots"><i></i><i></i><i></i></span>
      <strong>Friday</strong>
      <span class="fr-showcase-app__actions">
        <i aria-label={labels.history}><Icon name="History" size={17} /></i>
        <i aria-label={labels.profile}><Icon name="UserRound" size={17} /></i>
      </span>
    </header>

    <div class="fr-showcase-app__body">
      <div class="fr-showcase-conversation">
        <div class="fr-showcase-history">
          {labels.previousRequests.map((item) => (
            <article class={`fr-showcase-history__item is-${item.type}`}>
              <p>{item.request}</p>
              <div>
                <span class="fr-showcase-history__icon"><Icon name={item.type === "image" ? "Image" : "Music"} size={14} /></span>
                {item.type === "image" ? (
                  <img src="/demo/image-1783437002924.jpeg" alt={item.assetAlt ?? ""} width="1280" height="720" loading="eager" decoding="async" />
                ) : (
                  <span class="fr-showcase-wave" aria-hidden="true">
                    {[8, 15, 10, 22, 17, 27, 13, 21, 30, 16, 24, 11, 19, 8].map((height) => <i style={`--wave-height:${height}px`}></i>)}
                  </span>
                )}
                <span class="fr-showcase-history__copy"><small>{item.tool}</small><strong>{item.result}</strong></span>
                <time>{item.meta}</time>
              </div>
            </article>
          ))}
        </div>

        <div class="fr-showcase-request">
          <p>{labels.request}</p>
          <span>
            <i aria-label={labels.copy}><Icon name="Copy" size={14} /></i>
            <i aria-label={labels.edit}><Icon name="Pencil" size={14} /></i>
          </span>
        </div>

        <div class="fr-showcase-tool">
          <span><Icon name="Video" size={14} /><strong>{labels.tool}</strong><Icon name="Check" size={13} /></span>
          <small>{labels.tokens}<Icon name="ChevronDown" size={13} /></small>
        </div>

        <figure
          class="fr-showcase-media"
          data-showcase-video
          data-mute-label={labels.mute}
          data-pause-label={labels.pause}
          data-play-label={labels.play}
          data-unmute-label={labels.unmute}
        >
          <video aria-label={labels.assetAlt} playsinline poster="/demo/image-1783269109315.jpeg" preload="metadata" data-showcase-video-media>
            <source src="/demo/video-1784367922287.mp4" type="video/mp4" />
          </video>
          <div class="fr-showcase-media__controls">
            <button aria-label={labels.play} type="button" data-showcase-play>
              <span class="fr-showcase-play-icon"><Icon name="Play" size={18} /></span>
              <span class="fr-showcase-pause-icon"><Icon name="Pause" size={18} /></span>
            </button>
            <input aria-label={labels.seek} type="range" min="0" max="100" step="0.1" value="0" data-showcase-progress />
            <time datetime="PT0S" data-showcase-time>0:00</time>
            <button aria-label={labels.unmute} type="button" data-showcase-volume>
              <span class="fr-showcase-volume-icon"><Icon name="Volume2" size={18} /></span>
              <span class="fr-showcase-muted-icon"><Icon name="VolumeX" size={18} /></span>
            </button>
            <button aria-label={labels.fullscreen} type="button" data-showcase-fullscreen><Icon name="Maximize" size={17} /></button>
          </div>
        </figure>

        <p class="fr-showcase-complete">{labels.complete}</p>
      </div>

      <div class="fr-showcase-composer">
        <span aria-label={labels.attach}><Icon name="Plus" size={18} /></span>
        <p>{labels.composer}</p>
        <span aria-label={labels.dictate}><Icon name="Mic" size={18} /></span>
        <strong aria-label={labels.voice}><Icon name="AudioLines" size={19} /></strong>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    document.querySelectorAll("[data-showcase-video]").forEach((player) => {
      if (player.dataset.ready === "true") return;
      player.dataset.ready = "true";

      const video = player.querySelector("[data-showcase-video-media]");
      const playButton = player.querySelector("[data-showcase-play]");
      const progress = player.querySelector("[data-showcase-progress]");
      const time = player.querySelector("[data-showcase-time]");
      const volumeButton = player.querySelector("[data-showcase-volume]");
      const fullscreenButton = player.querySelector("[data-showcase-fullscreen]");
      if (!video || !playButton || !progress || !time || !volumeButton || !fullscreenButton) return;

      const formatTime = (seconds) => {
        const safeSeconds = Number.isFinite(seconds) ? Math.max(0, seconds) : 0;
        const minutes = Math.floor(safeSeconds / 60);
        return `${minutes}:${String(Math.floor(safeSeconds % 60)).padStart(2, "0")}`;
      };

      const updatePlayback = () => {
        const percent = video.duration ? (video.currentTime / video.duration) * 100 : 0;
        progress.value = String(percent);
        progress.style.setProperty("--showcase-progress", `${percent}%`);
        time.textContent = formatTime(video.currentTime);
        time.dateTime = `PT${Math.floor(video.currentTime)}S`;
      };

      const updatePlayState = () => {
        const playing = !video.paused && !video.ended;
        player.classList.toggle("is-playing", playing);
        playButton.setAttribute("aria-label", playing ? player.dataset.pauseLabel : player.dataset.playLabel);
      };

      const updateVolumeState = () => {
        const unmuted = !video.muted;
        player.classList.toggle("is-unmuted", unmuted);
        volumeButton.setAttribute("aria-label", unmuted ? player.dataset.muteLabel : player.dataset.unmuteLabel);
      };

      playButton.addEventListener("click", () => video.paused ? video.play().catch(() => {}) : video.pause());
      progress.addEventListener("input", () => {
        if (!video.duration) return;
        video.currentTime = (Number(progress.value) / 100) * video.duration;
      });
      volumeButton.addEventListener("click", () => {
        video.muted = !video.muted;
        updateVolumeState();
      });
      fullscreenButton.addEventListener("click", () => player.requestFullscreen?.());
      video.addEventListener("play", updatePlayState);
      video.addEventListener("pause", updatePlayState);
      video.addEventListener("ended", updatePlayState);
      video.addEventListener("timeupdate", updatePlayback);
      video.addEventListener("loadedmetadata", updatePlayback);
      updatePlayState();
      updateVolumeState();
      updatePlayback();
    });
  })();
</script>
