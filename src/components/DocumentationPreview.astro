---
import { getCollection } from "astro:content";
import DocCard from "./DocCard.astro";
import Icon from "./Icon.astro";
import { categoryIcons, docsPath, groupDocs } from "../lib/docs";

const docs = (await getCollection("docs")).sort((a, b) => a.data.sourcePath.localeCompare(b.data.sourcePath));
const groups = groupDocs(docs);
const featuredSources = [
  "models/index.md",
  "providers/index.md",
  "channels/index.md",
  "connectors/index.md",
  "system/index.md",
  "ai/tools.md",
];
const featuredDocs = featuredSources
  .map((sourcePath) => docs.find((doc) => doc.data.sourcePath === sourcePath))
  .filter(Boolean)
  .slice(0, 6);
---

<section class="section reference-section docs-preview-section" id="docs">
  <div class="shell">
    <header class="reference-head">
      <p class="eyebrow">Documentation</p>
      <h2>Product behavior, wired from the source docs.</h2>
    </header>

    <div class="docs-preview-metrics" aria-label="Documentation coverage">
      <div>
        <strong>{docs.length}</strong>
        <span>docs pages</span>
      </div>
      <div>
        <strong>{groups.length}</strong>
        <span>sections</span>
      </div>
      <div>
        <strong>Static</strong>
        <span>Astro content</span>
      </div>
    </div>

    <div class="docs-preview-grid">
      {
        featuredDocs.map((doc) => (
          <DocCard
            title={doc.data.title}
            description={doc.data.description}
            href={docsPath(doc.data.sourcePath)}
            category={doc.data.category}
            icon={categoryIcons[doc.data.category] ?? "BookOpen"}
          />
        ))
      }
    </div>

    <a class="text-link section-link" href="/docs">
      Browse all documentation
      <Icon name="ArrowRight" size={16} />
    </a>
  </div>
</section>
