---
import socialLinks from "../data/social-links.json";
import { getLocaleContent, localeMeta, locales, localizedPath, normalizeLocale, type Locale } from "../i18n";
import Icon from "./Icon.astro";

interface Props {
  locale?: Locale;
  alternatePath?: string;
}

const locale = normalizeLocale(Astro.props.locale);
const { alternatePath = "/" } = Astro.props;
const { site, ui } = getLocaleContent(locale);
const groups = ui.footerGroups;
const localizedRoutes = new Set(["/", "/docs", "/integrations", "/community", "/operators"]);
const footerHref = (href: string) => {
  const [path, hash] = href.split("#");
  const targetPath = path || "/";
  const resolvedPath = localizedRoutes.has(targetPath) ? localizedPath(targetPath, locale) : targetPath;
  return `${resolvedPath}${hash ? `#${hash}` : ""}`;
};
const localizedAlternatePath = (targetLocale: Locale) => localizedPath(alternatePath, targetLocale);
---

<footer class="site-footer">
  <div class="shell footer-grid">
    <div class="footer-brand">
      <a class="brand" href={localizedPath("/", locale)}>
        <span class="brand-mark" aria-hidden="true"></span>
        <span class="brand__text">
          <span>{site.name}</span>
          <small>{site.tagline}</small>
        </span>
      </a>
      <p>{site.description}</p>
      <div aria-label={ui.socialLinks} class="social-links">
        {
          socialLinks.map((link) => (
            <a aria-label={link.label} href={link.url}>
              <Icon name={link.icon} size={18} />
            </a>
          ))
        }
      </div>
      <div aria-label={ui.languageSwitcher} class="footer-language language-switcher">
        {
          locales.map((targetLocale) => (
            <a
              aria-current={targetLocale === locale ? "true" : undefined}
              class:list={["language-switcher__link", targetLocale === locale && "is-active"]}
              href={localizedAlternatePath(targetLocale)}
              hreflang={localeMeta[targetLocale].hreflang}
              lang={localeMeta[targetLocale].hreflang}
            >
              {localeMeta[targetLocale].shortLabel}
            </a>
          ))
        }
      </div>
    </div>

    {
      groups.map((group) => (
        <div class="footer-links">
          <h2>{group.title}</h2>
          {group.links.map((link) => <a href={footerHref(link.href)}>{link.label}</a>)}
        </div>
      ))
    }
  </div>
  <div class="shell footer-bottom">
    <span>Copyright {new Date().getFullYear()} {site.name}. {ui.footerRights}</span>
    <span>{ui.footerPermissionNote}</span>
  </div>
</footer>
