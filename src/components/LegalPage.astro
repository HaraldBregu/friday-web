---
import Layout from "../layouts/Layout.astro";
import type { Locale } from "../i18n";

interface Section {
  title: string;
  paragraphs: string[];
}

interface Props {
  locale: Locale;
  alternatePath: string;
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
  intro: string;
  updated: string;
  sections: Section[];
}

const { locale, alternatePath, title, description, eyebrow, heading, intro, updated, sections } = Astro.props;
---

<Layout {locale} {alternatePath} {title} {description}>
  <section class="section article-shell">
    <div class="shell">
      <header class="article-header">
        <p class="eyebrow">{eyebrow}</p>
        <h1>{heading}</h1>
        <p>{intro}</p>
        <p class="article-meta">{updated}</p>
      </header>
      <div class="article-body">
        {sections.map((section) => (
          <section>
            <h2>{section.title}</h2>
            {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </section>
        ))}
      </div>
    </div>
  </section>
</Layout>
