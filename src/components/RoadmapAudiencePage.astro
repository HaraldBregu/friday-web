---
import CTASection from "./CTASection.astro";
import Icon from "./Icon.astro";
import Layout from "../layouts/Layout.astro";

interface Props {
  icon: string;
  eyebrow: string;
  title: string;
  description: string;
  groups: { title: string; items: string[] }[];
}

const { icon, eyebrow, title, description, groups } = Astro.props;
---

<Layout title={`${eyebrow} roadmap`} description={description}>
  <section class="section page-hero">
    <div class="shell section-heading audience-intro">
      <span class="audience-icon"><Icon name={icon} size={24} /></span>
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <p>{description}</p>
    </div>
  </section>

  <section class="section section--compact">
    <div class="shell audience-groups">
      {groups.map((group) => (
        <article class="audience-group">
          <h2>{group.title}</h2>
          <ul>
            {group.items.map((item) => <li><Icon name="Check" size={16} />{item}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <CTASection
    eyebrow="Product direction"
    title="A roadmap built around useful coordination."
    description="Friday is designed to automate meaningful work while preserving clear permissions and human control."
  />
</Layout>

<style>
  .audience-intro { max-width: 780px; }
  .audience-icon { display: grid; width: 52px; height: 52px; place-items: center; margin-bottom: 1.2rem; border: 1px solid var(--line); border-radius: 50%; color: var(--accent); }
  .audience-groups { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .audience-group { border: 1px solid var(--line); border-radius: var(--radius); padding: clamp(1.25rem, 3vw, 1.7rem); background: var(--surface); }
  .audience-group h2 { margin: 0 0 1rem; font-size: 1.1rem; }
  .audience-group ul { display: grid; gap: 0.8rem; margin: 0; padding: 0; list-style: none; }
  .audience-group li { display: flex; align-items: flex-start; gap: 0.6rem; color: var(--text-soft); line-height: 1.55; }
  .audience-group li svg { flex: 0 0 auto; margin-top: 0.24rem; color: var(--accent); }
  @media (max-width: 700px) { .audience-groups { grid-template-columns: 1fr; } }
</style>
