---
import CTASection from "./CTASection.astro";
import Icon from "./Icon.astro";
import Layout from "../layouts/Layout.astro";

interface Props {
  icon: string;
  eyebrow: string;
  title: string;
  description: string;
  variant: "enterprise" | "education" | "personal";
  groups: { title: string; items: string[] }[];
}

const { icon, eyebrow, title, description, variant, groups } = Astro.props;
---

<Layout title={`${eyebrow} roadmap`} description={description}>
  <section class="audience-hero">
    <div class="shell audience-intro">
      <span class="audience-icon"><Icon name={icon} size={24} /></span>
      <p class="eyebrow">Friday for {eyebrow}</p>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
    </div>
  </section>

  <section class="section reference-section audience-capabilities" data-variant={variant}>
    <div class="shell">
      <header class="audience-section-head">
        <span class="section-tag">Capability map</span>
        <h2>Everything works <span>together.</span></h2>
        <p>Clear capability areas, designed around useful automation and permissioned actions.</p>
      </header>
      <div class="audience-groups">
      {groups.map((group, index) => (
        <article class="audience-group">
          <div class="audience-group__top">
            <span>AREA {String(index + 1).padStart(2, "0")}</span>
            <Icon name={icon} size={18} />
          </div>
          <h2>{group.title}</h2>
          <ul>
            {group.items.map((item) => <li><Icon name="Check" size={16} />{item}</li>)}
          </ul>
        </article>
      ))}
      </div>
      </div>
  </section>

  <CTASection
    eyebrow="Product direction"
    title="A roadmap built around useful coordination."
    description="Friday is designed to automate meaningful work while preserving clear permissions and human control."
  />
</Layout>

<style>
  .audience-hero { padding: clamp(5rem, 11vw, 8rem) 0 clamp(3.5rem, 8vw, 6rem); }
  .audience-intro { display: flex; flex-direction: column; align-items: center; max-width: 850px; text-align: center; }
  .audience-icon { display: grid; width: 52px; height: 52px; place-items: center; margin-bottom: 1.25rem; border: 1px solid var(--line-strong); border-radius: 50%; background: var(--accent-soft); color: var(--accent); }
  .audience-intro h1 { max-width: 12ch; margin: 0 0 1.25rem; font-size: clamp(3.2rem, 8vw, 6.5rem); line-height: 0.96; letter-spacing: -0.05em; }
  .audience-intro .lede { max-width: 60ch; margin: 0; }
  .audience-capabilities { padding-top: 0; }
  .audience-section-head { display: flex; flex-direction: column; align-items: center; max-width: 680px; margin: 0 auto 3.5rem; padding-top: 3.5rem; border-top: 1px solid var(--line); text-align: center; }
  .audience-section-head h2 { margin: 0; font-size: clamp(2.4rem, 6vw, 4.5rem); letter-spacing: -0.04em; line-height: 1; }
  .audience-section-head h2 span { color: var(--muted); }
  .audience-section-head p { max-width: 52ch; margin: 1.25rem 0 0; color: var(--muted); }
  .audience-groups { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem; }
  .audience-group { display: flex; flex-direction: column; min-height: 100%; border-top: 1px solid var(--line); padding-top: 1.25rem; }
  .audience-group__top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; color: var(--faint); font-family: var(--font-mono); font-size: 0.76rem; font-weight: 700; letter-spacing: 0.06em; }
  .audience-group__top svg { color: var(--accent); }
  .audience-group h2 { margin: 0 0 1.2rem; font-size: 1.35rem; letter-spacing: -0.025em; }
  .audience-group ul { display: grid; gap: 0.75rem; margin: 0; padding: 0; list-style: none; }
  .audience-group li { display: flex; align-items: flex-start; gap: 0.6rem; color: var(--text-soft); font-size: 0.94rem; line-height: 1.55; }
  .audience-group li svg { flex: 0 0 auto; margin-top: 0.22rem; color: var(--accent); }
  @media (max-width: 620px) { .audience-groups { grid-template-columns: 1fr; gap: 2.25rem; } .audience-section-head { margin-bottom: 2.5rem; } }
</style>
