---
import Icon from "./Icon.astro";
---

<div class="fr-knowledge-map" role="img" aria-label="Source files branching into Knowledge Base retrieval and LLM Wiki compilation, then reconnecting as a grounded Friday answer">
  <div class="fr-knowledge-map__sources">
    <span class="fr-map-label">Your sources</span>
    <div class="fr-source-stack">
      <span><Icon name="BookOpen" size={14} /><code>research.md</code></span>
      <span><Icon name="TerminalSquare" size={14} /><code>decisions.log</code></span>
      <span><Icon name="Database" size={14} /><code>notes.csv</code></span>
    </div>
  </div>

  <div class="fr-map-connector fr-map-connector--left" aria-hidden="true"></div>
  <div class="fr-map-connector fr-map-connector--right" aria-hidden="true"></div>

  <div class="fr-map-route fr-map-route--rag">
    <div class="fr-map-route__head">
      <span><Icon name="Search" size={16} /></span>
      <div><small>Knowledge Base</small><strong>Retrieve exact excerpts</strong></div>
    </div>
    <div class="fr-excerpt">
      <span><code>research.md:128</code><b>0.94</b></span>
      <p>“Provider selection stays in the user’s control…”</p>
    </div>
    <div class="fr-excerpt">
      <span><code>decisions.log:42</code><b>0.87</b></span>
      <p>“Release scope includes all three desktop platforms…”</p>
    </div>
  </div>

  <div class="fr-map-route fr-map-route--wiki">
    <div class="fr-map-route__head">
      <span><Icon name="BookOpen" size={16} /></span>
      <div><small>LLM Wiki</small><strong>Maintain durable synthesis</strong></div>
    </div>
    <div class="fr-wiki-pages">
      <article><code>[[Release readiness]]</code><p>3 supported claims</p><span>confidence · high</span></article>
      <article><code>[[Provider control]]</code><p>5 linked sources</p><span>evidence · checked</span></article>
      <article class="has-contradiction"><code>[[Open questions]]</code><p>1 unresolved item</p><span>contradiction · open</span></article>
    </div>
  </div>

  <div class="fr-map-connector fr-map-connector--merge" aria-hidden="true"></div>

  <div class="fr-map-answer">
    <img src="/icon-rounded.png" width="28" height="28" alt="" />
    <div><small>Grounded answer</small><strong>Synthesis with evidence when precision matters.</strong></div>
    <Icon name="CheckCircle2" size={17} />
  </div>
</div>
