---
import DownloadMenu from "./DownloadMenu.astro";
import Icon from "./Icon.astro";
import MiniAppDemo from "./MiniAppDemo.astro";
import friday from "../data/friday-product.json";
import site from "../data/site.json";
import socialLinks from "../data/social-links.json";

const githubUrl = socialLinks.find((link) => link.label === "GitHub")?.url;
const visibleChannels = friday.channelCatalog.slice(0, 10);
const visibleProviders = friday.providerExamples.slice(0, 12);
---

<section class="lp-hero" id="product">
  <div class="shell lp-hero__inner">
    <div class="lp-hero__copy">
      <p class="eyebrow">
        {friday.release.version}
        <span>/</span>
        {friday.release.platform}
        <span>/</span>
        {friday.release.phase}
      </p>
      <h1 class="wordmark">Friday<span>.</span></h1>
      <p class="lede">{friday.hero.description}</p>
      <div class="cta-row">
        <DownloadMenu label={site.cta.label} />
        {
          githubUrl ? (
            <a class="button button--secondary" href={githubUrl}>
              <Icon name="Github" size={17} />
              GitHub
            </a>
          ) : null
        }
        <a class="text-link" href="/blog">
          Release notes
          <Icon name="ArrowRight" size={16} />
        </a>
      </div>
    </div>

    <MiniAppDemo />
  </div>
</section>

<section class="metric-strip" aria-label="Friday product signals">
  <div class="shell metric-strip__inner">
    {
      friday.landingMetrics.map((metric) => (
        <div>
          <strong>{metric.value}</strong>
          <span>{metric.label}</span>
        </div>
      ))
    }
  </div>
</section>

<section class="section features-section" id="features">
  <div class="shell">
    <header class="features-head">
      <p class="eyebrow">Features</p>
      <h2>Six things, done well.</h2>
    </header>
    <div class="features-grid">
      {
        friday.landingFeatures.map((feature) => (
          <article class="feature">
            <p>{feature.key}</p>
            <h3>{feature.title}</h3>
            <p>{feature.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section class="section section--muted" id="workflow">
  <div class="shell split-section">
    <div>
      <p class="eyebrow">Workflow</p>
      <h2>Ask for help without giving up control.</h2>
      <p>
        Friday keeps the useful parts of an agent close to the user: planned work,
        tool access, approval state, and delivery targets stay visible before work
        leaves the local desktop.
      </p>
    </div>
    <div class="step-list">
      {
        friday.workflowSteps.map((step, index) => (
          <article>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section class="section">
  <div class="shell surface-grid">
    <article class="surface-panel surface-panel--wide">
      <p class="eyebrow">Providers</p>
      <h2>Bring the models and services you trust.</h2>
      <p>
        Configure providers for chat, speech, images, research, audio, and realtime
        voice. Friday keeps provider choice explicit instead of hiding it behind a
        single black-box assistant.
      </p>
      <div class="tag-cloud" aria-label="Provider examples">
        {visibleProviders.map((provider) => <span>{provider}</span>)}
      </div>
    </article>
    <article class="surface-panel">
      <p class="eyebrow">Permissions</p>
      <h2>Risky work can pause.</h2>
      <ul class="plain-list">
        {friday.connectorPolicies.map((policy) => <li>{policy}</li>)}
        <li>Review writes, deletes, publishes, and private data access</li>
      </ul>
    </article>
  </div>
</section>

<section class="section section--muted" id="connectors">
  <div class="shell split-section split-section--reverse">
    <div>
      <p class="eyebrow">Channels</p>
      <h2>Meet Friday where work already happens.</h2>
      <p>
        Connect team and personal channels with account labels, default targets,
        allowlists, pairing rules, and runtime status controls.
      </p>
      <a class="text-link" href="/integrations">
        View all integrations
        <Icon name="ArrowRight" size={16} />
      </a>
    </div>
    <div class="tag-cloud tag-cloud--large" aria-label="Supported messaging channels">
      {visibleChannels.map((channel) => <span>{channel}</span>)}
      <span>{friday.channelCatalog.length - visibleChannels.length} more</span>
    </div>
  </div>
</section>

<section class="section" id="privacy">
  <div class="shell privacy-section">
    <div>
      <p class="eyebrow">Privacy</p>
      <h2>Local-first by default, connected when you choose.</h2>
    </div>
    <div class="privacy-list">
      {
        friday.privacyNotes.slice(0, 4).map((note) => (
          <article>
            <Icon name="ShieldCheck" size={18} />
            <p>{note}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section class="download-section" id="download">
  <div class="shell download-section__inner">
    <p class="eyebrow">Download Friday</p>
    <h2>Start with one trusted workflow, then connect more.</h2>
    <p>
      Install the desktop app, choose providers, review permissions, and add only
      the tools, channels, skills, and schedules you want Friday to use.
    </p>
    <div class="cta-row cta-row--center">
      <DownloadMenu label="Download for desktop" />
      <a class="button button--secondary" href="#privacy">
        <Icon name="ShieldCheck" size={17} />
        Review privacy
      </a>
    </div>
  </div>
</section>
