---
import DownloadMenu from "./DownloadMenu.astro";
import Icon from "./Icon.astro";
import MiniAppDemo from "./MiniAppDemo.astro";
import friday from "../data/friday-product.json";
import site from "../data/site.json";
import socialLinks from "../data/social-links.json";

const githubUrl = socialLinks.find((link) => link.label === "GitHub")?.url;
---

<section class="lp-hero" id="product">
  <div class="shell lp-hero__inner">
    <p class="eyebrow">
      {friday.release.version}
      <span>/</span>
      {friday.release.platform}
      <span>/</span>
      {friday.release.phase}
    </p>
    <h1 class="wordmark">Friday<span>.</span></h1>
    <p class="lede">{friday.hero.description}</p>
    <div class="cta-row">
      <DownloadMenu label={site.cta.label} />
      {
        githubUrl ? (
          <a class="button button--secondary" href={githubUrl}>
            <Icon name="Github" size={17} />
            GitHub
          </a>
        ) : null
      }
      <a class="text-link" href="/blog">
        Release notes
        <Icon name="ArrowRight" size={16} />
      </a>
    </div>

    <div class="mini-app-wrap">
      <MiniAppDemo />
    </div>
  </div>
</section>

<section class="section reference-section" id="features">
  <div class="shell">
    <header class="reference-head">
      <p class="eyebrow">Features</p>
      <h2>Six things, done well.</h2>
    </header>
    <div class="features-grid">
      {
        friday.landingFeatures.map((feature) => (
          <article class="feature">
            <p>{feature.key}</p>
            <h3>{feature.title}</h3>
            <p>{feature.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section class="section reference-section" id="how">
  <div class="shell">
    <header class="reference-head">
      <p class="eyebrow">How it works</p>
      <h2>Three steps, one focused loop.</h2>
    </header>
    <div class="how-steps">
      {
        friday.howSteps.map((step) => (
          <article class="how-step">
            <p>{step.label}</p>
            <span>{step.glyph}</span>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section class="quote-section">
  <div class="shell quote-section__inner">
    <span aria-hidden="true">"</span>
    <p>{friday.quote.text}</p>
    <cite>{friday.quote.cite}</cite>
  </div>
</section>

<section class="section reference-section" id="pricing">
  <div class="shell">
    <header class="reference-head">
      <p class="eyebrow">Pricing</p>
      <h2>Free while Friday is in beta.</h2>
    </header>
    <div class="pricing-grid">
      {
        friday.pricingPlans.map((plan) => (
          <article class={`pricing-plan ${plan.featured ? "pricing-plan--featured" : ""}`}>
            {plan.badge ? <span class="pricing-plan__badge">{plan.badge}</span> : null}
            <p class="pricing-plan__name">{plan.name}</p>
            <div class="pricing-plan__price">
              <strong>{plan.price}</strong>
              <span>{plan.period}</span>
            </div>
            <p>{plan.description}</p>
            <ul>
              {plan.items.map((item) => <li>{item}</li>)}
            </ul>
            <a class={plan.featured ? "pricing-plan__cta pricing-plan__cta--primary" : "pricing-plan__cta"} href={plan.href}>
              {plan.cta}
              <Icon name="ArrowRight" size={16} />
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section class="section reference-section" id="faq">
  <div class="shell">
    <header class="reference-head">
      <p class="eyebrow">FAQ</p>
      <h2>Common questions.</h2>
    </header>
    <div class="faq-list">
      {
        friday.faqs.map((faq, index) => (
          <details class="faq-item" open={index === 0}>
            <summary>
              <span>{faq.question}</span>
              <Icon name="Plus" size={18} />
            </summary>
            <p>{faq.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<section class="download-section" id="download">
  <div class="shell download-section__inner">
    <h2>One keystroke away.</h2>
    <div class="cta-row cta-row--center">
      <DownloadMenu label="Download for Mac" />
      {
        githubUrl ? (
          <a class="button button--secondary" href={githubUrl}>
            <Icon name="Github" size={17} />
            Star on GitHub
          </a>
        ) : null
      }
    </div>
    <p>{friday.release.platform} / Apple Silicon and Intel / {friday.release.version} beta</p>
  </div>
</section>
