---
import DownloadMenu from "./DownloadMenu.astro";
import DocumentationPreview from "./DocumentationPreview.astro";
import Icon from "./Icon.astro";
import ProductMockup from "./ProductMockup.astro";
import socialLinks from "../data/social-links.json";
import { getLocaleContent, localizedPath, normalizeLocale, type Locale } from "../i18n";

interface Props {
  locale?: Locale;
}

const locale = normalizeLocale(Astro.props.locale);
const { friday, home, site, ui } = getLocaleContent(locale);

const sp = (t: string) => {
  const i = t.indexOf("|");
  return i === -1 ? [t, ""] : [t.slice(0, i), t.slice(i + 1)];
};
const githubUrl = socialLinks.find((link) => link.label === "GitHub")?.url;
const landingMetrics = friday.landingMetrics;
const connectorHighlights = friday.landingConnectors;
const channelHighlights = friday.landingChannels;
const operatorHighlights = friday.landingOperators;
const providerGroups = friday.landingProviderGroups;
---

<section class="lp-hero" id="product">
  <div class="shell lp-hero__inner">
    <div class="lp-hero__copy">
      <p class="eyebrow">
        {friday.release.version}
        <span>/</span>
        {friday.release.platform}
        <span>/</span>
        {friday.release.phase}
      </p>
      <h1 class="wordmark">Friday<span>.</span></h1>
      <p class="lede">{friday.hero.description}</p>
      <div class="cta-row">
        <DownloadMenu label={site.cta.label} locale={locale} />
        {
          githubUrl ? (
            <a class="button button--secondary" href={githubUrl}>
              <Icon name="Github" size={17} />
              {ui.github}
            </a>
          ) : null
        }
        <a class="text-link" href="/blog">
          {ui.releaseNotes}
          <Icon name="ArrowRight" size={16} />
        </a>
      </div>
      <div class="hero-metrics" aria-label="Feature runtime status">
        {
          landingMetrics.map((metric) => (
            <div>
              <strong>{metric.value}</strong>
              <span>{metric.label}</span>
            </div>
          ))
        }
      </div>
    </div>

    <div class="lp-hero__preview">
      <ProductMockup locale={locale} />
    </div>
  </div>
</section>

<section class="section reference-section" id="features">
  <div class="shell">
    <header class="reference-head">
      <span class="section-tag">§ 01 — {home.featuresEyebrow}</span>
      <h2>{sp(home.featuresTitle)[0]}{sp(home.featuresTitle)[1] && <><br/><span class="heading-muted">{sp(home.featuresTitle)[1]}</span></>}</h2>
    </header>
    <div class="features-grid">
      {
        friday.landingFeatures.map((feature) => (
          <article class="feature">
            <div class="feature__meta">
              <span>{feature.key}</span>
            </div>
            <h3>{feature.title}</h3>
            <p>{feature.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section class="section reference-section" id="how">
  <div class="shell">
    <header class="reference-head">
      <span class="section-tag">§ 02 — {home.howEyebrow}</span>
      <h2>{sp(home.howTitle)[0]}{sp(home.howTitle)[1] && <><br/><span class="heading-muted">{sp(home.howTitle)[1]}</span></>}</h2>
    </header>
    <div class="how-steps">
      {
        friday.howSteps.map((step) => (
          <article class="how-step">
            <p>{step.label}</p>
            <span>{step.glyph}</span>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section class="quote-section">
  <div class="shell quote-section__inner">
    <span aria-hidden="true">"</span>
    <p>{friday.quote.text}</p>
    <cite>{friday.quote.cite}</cite>
  </div>
</section>

<section class="section reference-section" id="connectors">
  <div class="shell">
    <header class="reference-head">
      <span class="section-tag">§ 03 — {home.connectorsEyebrow}</span>
      <h2>{sp(home.connectorsTitle)[0]}{sp(home.connectorsTitle)[1] && <><br/><span class="heading-muted">{sp(home.connectorsTitle)[1]}</span></>}</h2>
    </header>
    <div class="connector-grid">
      {
        connectorHighlights.map((connector) => (
          <article class="connector-card">
            <div class="connector-card__top">
              <div class="card-icon">
                <Icon name={connector.icon} size={19} />
              </div>
              <span>{connector.label}</span>
            </div>
            <h3>{connector.name}</h3>
            <p>{connector.description}</p>
          </article>
        ))
      }
    </div>
    <a class="text-link section-link" href={localizedPath("/integrations", locale)}>
      {ui.viewAllIntegrations}
      <Icon name="ArrowRight" size={16} />
    </a>
  </div>
</section>

<section class="section reference-section" id="channels">
  <div class="shell">
    <header class="reference-head">
      <span class="section-tag">§ 04 — {home.channelsEyebrow}</span>
      <h2>{sp(home.channelsTitle)[0]}{sp(home.channelsTitle)[1] && <><br/><span class="heading-muted">{sp(home.channelsTitle)[1]}</span></>}</h2>
    </header>
    <div class="channel-panel">
      <div class="channel-cloud" aria-label={ui.supportedChannels}>
        {channelHighlights.map((channel) => <span>{channel}</span>)}
      </div>
      <div class="channel-copy">
        <h3>{home.channelsPanelTitle}</h3>
        <p>{home.channelsPanelDescription}</p>
      </div>
    </div>
  </div>
</section>

<section class="section reference-section" id="operators">
  <div class="shell">
    <header class="reference-head">
      <span class="section-tag">§ 05 — {home.operatorsEyebrow}</span>
      <h2>{sp(home.operatorsTitle)[0]}{sp(home.operatorsTitle)[1] && <><br/><span class="heading-muted">{sp(home.operatorsTitle)[1]}</span></>}</h2>
    </header>
    <div class="operator-highlights">
      {
        operatorHighlights.map((op) => (
          <article class="op-card">
            <div class="op-card__top">
              <div class="card-icon">
                <Icon name={op.icon} size={19} />
              </div>
              <span class={op.status === "Live" ? "op-status op-status--live" : "op-status op-status--soon"}>
                {op.status}
              </span>
            </div>
            <h3>{op.name}</h3>
            <p>{op.description}</p>
          </article>
        ))
      }
    </div>
    <a class="text-link section-link" href={localizedPath("/operators", locale)}>
      View all operators
      <Icon name="ArrowRight" size={16} />
    </a>
  </div>
</section>

<section class="section reference-section" id="providers">
  <div class="shell">
    <header class="reference-head">
      <span class="section-tag">§ 06 — {home.providersEyebrow}</span>
      <h2>{sp(home.providersTitle)[0]}{sp(home.providersTitle)[1] && <><br/><span class="heading-muted">{sp(home.providersTitle)[1]}</span></>}</h2>
    </header>
    <div class="provider-groups">
      {
        providerGroups.map((group) => (
          <div class="provider-group">
            <p class="provider-group__label">{group.label}</p>
            <div class="provider-group__chips">
              {group.examples.map((ex) => <span>{ex}</span>)}
            </div>
          </div>
        ))
      }
    </div>
    <a class="text-link section-link" href={localizedPath("/providers", locale)}>
      View all providers
      <Icon name="ArrowRight" size={16} />
    </a>
  </div>
</section>

{locale === "en" ? <DocumentationPreview /> : null}

<section class="section reference-section" id="faq">
  <div class="shell">
    <header class="reference-head reference-head--right">
      <div class="section-tag-row">
        <span class="section-tag">§ 07 · {home.faqEyebrow}</span>
      </div>
      <h2>{home.faqTitle}</h2>
    </header>
    <div class="faq-list">
      {
        friday.faqs.map((faq, index) => (
          <details class="faq-item" open={index === 0}>
            <summary>
              <span>{faq.question}</span>
              <Icon name="Plus" size={18} />
            </summary>
            <p>{faq.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<section class="download-section" id="download">
  <div class="shell download-section__inner">
    <h2>{home.downloadTitle}</h2>
    <div class="cta-row cta-row--center">
      <DownloadMenu label={home.downloadLabel} locale={locale} />
      {
        githubUrl ? (
          <a class="button button--secondary" href={githubUrl}>
            <Icon name="Github" size={17} />
            {ui.starOnGithub}
          </a>
        ) : null
      }
    </div>
    <p>{friday.release.platform} / {home.releaseFootnote} / {friday.release.version} beta</p>
  </div>
</section>
