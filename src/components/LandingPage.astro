---
import DownloadMenu from "./DownloadMenu.astro";
import Icon from "./Icon.astro";
import MiniAppDemo from "./MiniAppDemo.astro";
import friday from "../data/friday-product.json";
import site from "../data/site.json";
import socialLinks from "../data/social-links.json";

const githubUrl = socialLinks.find((link) => link.label === "GitHub")?.url;
const connectorHighlights = friday.landingConnectors;
const channelHighlights = friday.landingChannels;
---

<section class="lp-hero" id="product">
  <div class="shell lp-hero__inner">
    <p class="eyebrow">
      {friday.release.version}
      <span>/</span>
      {friday.release.platform}
      <span>/</span>
      {friday.release.phase}
    </p>
    <h1 class="wordmark">Friday<span>.</span></h1>
    <p class="lede">{friday.hero.description}</p>
    <div class="cta-row">
      <DownloadMenu label={site.cta.label} />
      {
        githubUrl ? (
          <a class="button button--secondary" href={githubUrl}>
            <Icon name="Github" size={17} />
            GitHub
          </a>
        ) : null
      }
      <a class="text-link" href="/blog">
        Release notes
        <Icon name="ArrowRight" size={16} />
      </a>
    </div>

    <div class="mini-app-wrap">
      <MiniAppDemo />
    </div>
  </div>
</section>

<section class="section reference-section" id="features">
  <div class="shell">
    <header class="reference-head">
      <p class="eyebrow">Features</p>
      <h2>Six things, done well.</h2>
    </header>
    <div class="features-grid">
      {
        friday.landingFeatures.map((feature) => (
          <article class="feature">
            <p>{feature.key}</p>
            <h3>{feature.title}</h3>
            <p>{feature.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section class="section reference-section" id="how">
  <div class="shell">
    <header class="reference-head">
      <p class="eyebrow">How it works</p>
      <h2>Three steps, one focused loop.</h2>
    </header>
    <div class="how-steps">
      {
        friday.howSteps.map((step) => (
          <article class="how-step">
            <p>{step.label}</p>
            <span>{step.glyph}</span>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section class="quote-section">
  <div class="shell quote-section__inner">
    <span aria-hidden="true">"</span>
    <p>{friday.quote.text}</p>
    <cite>{friday.quote.cite}</cite>
  </div>
</section>

<section class="section reference-section" id="connectors">
  <div class="shell">
    <header class="reference-head">
      <p class="eyebrow">Connectors</p>
      <h2>Connect Google, calendar, files, and the apps around your day.</h2>
    </header>
    <div class="connector-grid">
      {
        connectorHighlights.map((connector) => (
          <article class="connector-card">
            <div class="connector-card__top">
              <div class="card-icon">
                <Icon name={connector.icon} size={19} />
              </div>
              <span>{connector.label}</span>
            </div>
            <h3>{connector.name}</h3>
            <p>{connector.description}</p>
          </article>
        ))
      }
    </div>
    <a class="text-link section-link" href="/integrations">
      View all integrations
      <Icon name="ArrowRight" size={16} />
    </a>
  </div>
</section>

<section class="section reference-section" id="channels">
  <div class="shell">
    <header class="reference-head">
      <p class="eyebrow">Channels</p>
      <h2>Send updates and approvals through the channels teams already use.</h2>
    </header>
    <div class="channel-panel">
      <div class="channel-cloud" aria-label="Supported messaging channels">
        {channelHighlights.map((channel) => <span>{channel}</span>)}
      </div>
      <div class="channel-copy">
        <h3>Channel controls stay explicit.</h3>
        <p>
          Configure account labels, default targets, allowlists, pairing rules,
          runtime state, and delivery behavior before Friday posts into a channel.
        </p>
      </div>
    </div>
  </div>
</section>

<section class="section reference-section" id="faq">
  <div class="shell">
    <header class="reference-head">
      <p class="eyebrow">FAQ</p>
      <h2>Common questions.</h2>
    </header>
    <div class="faq-list">
      {
        friday.faqs.map((faq, index) => (
          <details class="faq-item" open={index === 0}>
            <summary>
              <span>{faq.question}</span>
              <Icon name="Plus" size={18} />
            </summary>
            <p>{faq.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<section class="download-section" id="download">
  <div class="shell download-section__inner">
    <h2>One keystroke away.</h2>
    <div class="cta-row cta-row--center">
      <DownloadMenu label="Download for Mac" />
      {
        githubUrl ? (
          <a class="button button--secondary" href={githubUrl}>
            <Icon name="Github" size={17} />
            Star on GitHub
          </a>
        ) : null
      }
    </div>
    <p>{friday.release.platform} / Apple Silicon and Intel / {friday.release.version} beta</p>
  </div>
</section>
