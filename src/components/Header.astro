---
import Icon from "./Icon.astro";
import ThemeToggle from "./ThemeToggle.astro";
import friday from "../data/friday-product.json";

const visibleNav = friday.nav.filter((item) => item.label !== "Download");
const navHref = (href: string) => (href.startsWith("#") ? `/${href}` : href);
---

<header class="site-header">
  <nav aria-label="Primary navigation" class="nav">
    <a class="brand" href="/#product">
      <span class="brand-mark" aria-hidden="true"></span>
      <span class="brand__text">Friday</span>
    </a>
    <div class="nav__links">
      {visibleNav.map((item) => <a href={navHref(item.href)}>{item.label}</a>)}
    </div>
    <div class="nav__actions">
      <ThemeToggle />
      <a class="nav__cta" href="/#download">
        Download
        <Icon name="ArrowRight" size={14} />
      </a>
    </div>
  </nav>
</header>
