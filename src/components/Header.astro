---
import Icon from "./Icon.astro";
import ThemeToggle from "./ThemeToggle.astro";
import socialLinks from "../data/social-links.json";
import { getLocaleContent, localizedPath, normalizeLocale, type Locale } from "../i18n";

interface Props {
  locale?: Locale;
  alternatePath?: string;
}

const locale = normalizeLocale(Astro.props.locale);
const { friday, ui } = getLocaleContent(locale);

const visibleNav = friday.nav.filter((item) => item.href !== "#download");
const navHref = (href: string) => (href.startsWith("#") ? `${localizedPath("/", locale)}${href}` : localizedPath(href, locale));
const roadmapLinks = [
  { label: "Enterprise", href: "/enterprise" },
  { label: "Education", href: "/education" },
  { label: "Personal", href: "/personal" },
];
const githubUrl = "https://github.com/HaraldBregu/friday";
---

<header class="site-header">
  <nav aria-label={ui.primaryNavigation} class="nav">
    <a class="brand" href={`${localizedPath("/", locale)}#product`}>
      <img alt="" class="brand-logo" height="30" src="/icon-rounded.png" width="30" />
      <span class="brand__text">Friday</span>
    </a>
    <div class="nav__links">
      {visibleNav.map((item) => <a href={navHref(item.href)}>{item.label}</a>)}
      <details class="nav-dropdown">
        <summary>Solutions <Icon name="ChevronDown" size={14} /></summary>
        <div class="nav-dropdown__panel">
          {roadmapLinks.map((item) => <a href={item.href}>{item.label}</a>)}
        </div>
      </details>
    </div>
    <div class="nav__actions">
      <ThemeToggle label={ui.themeToggle} />
      {
        githubUrl ? (
          <a class="nav__cta" href={githubUrl} target="_blank" rel="noreferrer">
            <Icon name="Github" size={16} />
            GitHub
          </a>
        ) : null
      }
    </div>
  </nav>
</header>
