---
import Icon from "./Icon.astro";
import friday from "../data/friday-product.json";
---

<header class="site-header">
  <nav aria-label="Primary navigation" class="nav nav--full">
    <a class="brand brand--pill" href="/#product">
      <span class="brand__mark">F</span>
      <span class="brand__text">Friday</span>
    </a>
    <div class="nav__links">
      {friday.nav.slice(0, 6).map((item) => <a href={`/${item.href}`}>{item.label}</a>)}
    </div>
    <div class="nav__actions">
      <a class="nav__cta" href="/#download">
        Download
        <Icon name="ArrowRight" size={14} />
      </a>
    </div>
  </nav>
</header>
