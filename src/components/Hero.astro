---
import FadeInText from "@astroanimate/core/FadeInText";
import ScaleIn from "@astroanimate/core/ScaleIn";
import site from "../data/site.json";
import Icon from "./Icon.astro";

const scriptResults = [
  { file: "hw_1.py", output: "Hello, world!" },
  { file: "hw_2.py", output: "Hello, tiny world!" },
  { file: "hw_3.py", output: "World says hello back." },
  { file: "hw_4.py", output: "Hello, world. That is all." },
  { file: "hw_5.py", output: "Hello world from script five." },
];

const previewModes = [
  { id: "setup", label: "Setup" },
  { id: "recording", label: "Recording" },
  { id: "call", label: "Live call" },
  { id: "text", label: "Text" },
];
---

<section class="hero">
  <div class="hero__scene">
    <div class="shell hero__inner">
      <FadeInText as="div" blur="10px" class="hero__copy" delay={0.05} duration={0.75} yOffset={18}>
        <h1>Friday</h1>
        <p class="hero__description">
          A desktop AI assistant for tools, files, and focused work.
        </p>
        <div class="hero__actions">
          <a class="button button--primary" href={site.cta.url}>
            {site.cta.label}
            <Icon name="ArrowRight" size={18} />
          </a>
        </div>
      </FadeInText>

      <ScaleIn
        as="div"
        class="friday-demo"
        data-friday-demo
        data-state="setup"
        delay={180}
        duration={700}
        enhance
        initialScale={0.96}
      >
        <div aria-label="Preview mode" class="demo-segment" role="tablist">
          {
            previewModes.map((mode, index) => (
              <button
                aria-selected={index === 0 ? "true" : "false"}
                class="demo-segment__button"
                data-demo-state={mode.id}
                role="tab"
                type="button"
              >
                {mode.label}
              </button>
            ))
          }
        </div>

        <div aria-label="Interactive Friday app preview" class="friday-window" data-window>
          <div class="friday-window__bar">
            <div aria-hidden="true" class="window-lights">
              <span class="window-lights__red"></span>
              <span class="window-lights__yellow"></span>
              <span></span>
            </div>
            <strong data-window-title>Set up Friday</strong>
            <button aria-label="Skip setup" class="skip-button" data-skip-setup type="button">
              Skip
            </button>
            <button aria-label="Open account panel" class="icon-button" type="button">
              <Icon name="UserRound" size={24} />
            </button>
            </div>

          <div class="friday-setup-screen">
            <div class="setup-stage">
              <div class="setup-wave-wrap">
                <svg aria-hidden="true" class="setup-wave-fallback" viewBox="0 0 640 160">
                  <path d="M24 82 C112 82 132 38 210 74 S336 120 426 76 532 50 616 82" />
                  <path d="M24 82 C118 88 154 118 232 84 S348 38 438 80 526 112 616 82" />
                  <path d="M24 82 C128 72 160 52 244 90 S356 126 444 72 542 62 616 82" />
                  <path d="M24 82 C110 96 152 64 238 76 S346 100 438 84 540 50 616 82" />
                  <path d="M24 82 C124 78 170 104 250 68 S352 44 440 88 534 98 616 82" />
                </svg>
                <canvas aria-hidden="true" class="setup-wave" data-dome-wave></canvas>
              </div>
              <span class="setup-badge">
                <Icon name="Check" size={17} />
                Setup takes about a minute
              </span>
              <h2>Welcome to Friday</h2>
              <p>
                Let's get your assistant ready. Connect one AI provider, choose the model
                Friday should use, and add the tools you want help with.
              </p>
            </div>
            <div class="setup-footer">
              <div class="setup-progress" aria-label="Welcome step, 1 of 3">
                <span class="setup-progress__bar"></span>
                <span></span>
                <span></span>
                <strong>Welcome</strong>
              </div>
              <button class="setup-primary" data-get-started type="button">
                <Icon name="ArrowRight" size={24} />
                Get started
              </button>
            </div>
          </div>

          <div class="friday-window__content">
            <p class="friday-prompt" data-user-message>
              run the scripts in the workspace and show me the results
            </p>

            <button
              aria-controls="friday-result-card"
              aria-expanded="true"
              class="reasoning-toggle"
              data-reasoning-toggle
              type="button"
            >
              <Icon class="reasoning-toggle__icon" name="ChevronRight" size={18} />
              <span>Finished</span>
            </button>

            <div class="thought-panel" data-thought-panel id="friday-result-card">
              <p class="thought-panel__label">Thought for a moment</p>
              <article class="result-card">
                <p data-assistant-summary>
                  I ran the scripts in the workspace. Here are the results:
                </p>
                <ul>
                  {
                    scriptResults.map((result) => (
                      <li>
                        <code>{result.file}</code>
                        <span aria-hidden="true">-&gt;</span>
                        <span>{result.output}</span>
                      </li>
                    ))
                  }
                </ul>
                <p>If you want, I can also inspect the scripts and explain how they work.</p>
              </article>
            </div>
          </div>

          <form aria-label="Friday message composer" class="friday-composer" data-composer>
            <button aria-label="Add attachment" class="composer-button" type="button">
              <Icon name="Plus" size={24} />
            </button>

            <div class="composer-pane composer-pane--recording">
              <button aria-label="Stop recording" class="record-button" type="button">
                <span></span>
              </button>
              <div aria-hidden="true" class="bar-wave">
                <span></span><span></span><span></span><span></span><span></span>
                <span></span><span></span><span></span><span></span><span></span>
                <span></span><span></span><span></span><span></span><span></span>
                <span></span><span></span><span></span><span></span><span></span>
              </div>
              <output class="composer-time" data-recording-time>0:13</output>
              <button aria-label="Cancel recording" class="composer-button composer-button--round" type="button">
                <Icon name="X" size={24} />
              </button>
              <button aria-label="Send recording" class="composer-button composer-button--confirm" type="button">
                <Icon name="Check" size={25} />
              </button>
            </div>

            <div class="composer-pane composer-pane--call">
              <button aria-label="Start voice session" class="call-button" type="button"></button>
              <svg aria-hidden="true" class="line-wave" viewBox="0 0 300 36">
                <path d="M0 18 C34 18 42 28 74 19 S118 6 152 17 196 30 228 18 264 7 300 17" />
                <path d="M0 18 C38 18 50 9 82 18 S130 30 162 17 202 7 236 18 268 27 300 19" />
              </svg>
              <button aria-label="Mute microphone" class="composer-button composer-button--round" type="button">
                <Icon name="Mic" size={22} />
              </button>
              <button class="end-call-button" type="button">
                <span aria-hidden="true">...</span>
                End
              </button>
            </div>

            <div class="composer-pane composer-pane--text">
              <input
                aria-label="Message Friday"
                autocomplete="off"
                data-chat-input
                name="message"
                type="text"
                value="Hello"
              />
              <button aria-label="Use voice input" class="composer-button composer-button--round" type="button">
                <Icon name="Mic" size={22} />
              </button>
              <button aria-label="Send message" class="composer-button composer-button--send" data-send type="submit">
                <Icon name="ArrowUp" size={24} />
              </button>
            </div>
          </form>
        </div>
      </ScaleIn>
    </div>
  </div>
</section>

<script>
  import * as THREE from "three";

  const domeWaveCanvases = document.querySelectorAll("[data-dome-wave]");

  const setupDomeWave = (canvas) => {
    if (!(canvas instanceof HTMLCanvasElement)) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const segments = 300;
    const waves = [
      { amp: 0.28, freq: 1.6, ph: 0.8, sp: 0.58, cL: [0.12, 0.7, 0.62], cM: [0.18, 0.58, 0.88], cR: [0.48, 0.25, 0.8] },
      { amp: 0.36, freq: 1.9, ph: 0, sp: 0.9, cL: [0.16, 0.84, 0.76], cM: [0.1, 0.6, 1], cR: [0.44, 0.2, 0.93] },
      { amp: 0.3, freq: 1.7, ph: 2.1, sp: 0.7, cL: [0.2, 0.9, 0.82], cM: [0.14, 0.66, 0.97], cR: [0.56, 0.33, 0.86] },
      { amp: 0.2, freq: 2.1, ph: 3.5, sp: 0.82, cL: [0.42, 0.28, 0.88], cM: [0.18, 0.6, 0.95], cR: [0.44, 0.3, 0.88] },
      { amp: 0.24, freq: 2.4, ph: 1.3, sp: 0.65, cL: [0.08, 0.75, 0.7], cM: [0.22, 0.5, 0.92], cR: [0.52, 0.18, 0.84] },
      { amp: 0.32, freq: 1.4, ph: 4.2, sp: 0.48, cL: [0.14, 0.8, 0.68], cM: [0.16, 0.62, 0.96], cR: [0.4, 0.28, 0.9] },
      { amp: 0.18, freq: 2.7, ph: 2.8, sp: 1.05, cL: [0.3, 0.55, 0.85], cM: [0.12, 0.58, 0.98], cR: [0.5, 0.22, 0.82] },
      { amp: 0.26, freq: 1.2, ph: 5.5, sp: 0.4, cL: [0.1, 0.85, 0.74], cM: [0.2, 0.64, 0.94], cR: [0.46, 0.32, 0.88] },
      { amp: 0.22, freq: 2.9, ph: 0.4, sp: 1.18, cL: [0.38, 0.3, 0.9], cM: [0.15, 0.55, 0.96], cR: [0.48, 0.26, 0.86] },
      { amp: 0.16, freq: 3.3, ph: 3, sp: 1.3, cL: [0.18, 0.78, 0.65], cM: [0.1, 0.64, 0.99], cR: [0.54, 0.2, 0.82] },
    ];

    const lerp = (a, b, t) => a + (b - a) * t;
    const dome = (x) => Math.cos(x * Math.PI * 0.5);
    const colorAt = (u, left, mid, right) =>
      u < 0.5
        ? [lerp(left[0], mid[0], u * 2), lerp(left[1], mid[1], u * 2), lerp(left[2], mid[2], u * 2)]
        : [lerp(mid[0], right[0], (u - 0.5) * 2), lerp(mid[1], right[1], (u - 0.5) * 2), lerp(mid[2], right[2], (u - 0.5) * 2)];

    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
    renderer.setClearColor(0, 0);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    const scene = new THREE.Scene();
    const camera = new THREE.OrthographicCamera(-1, 1, 0.45, -0.45, 0.1, 10);
    camera.position.z = 5;

    const waveData = waves.map((config, index) => {
      const geometry = new THREE.BufferGeometry();
      geometry.setAttribute("position", new THREE.BufferAttribute(new Float32Array((segments + 1) * 3), 3));
      geometry.setAttribute("color", new THREE.BufferAttribute(new Float32Array((segments + 1) * 3), 3));

      const colors = geometry.attributes.color.array;
      for (let i = 0; i <= segments; i += 1) {
        const u = i / segments;
        const x = u * 2 - 1;
        const fade = dome(x);
        const [r, g, b] = colorAt(u, config.cL, config.cM, config.cR);
        colors[i * 3] = r * fade;
        colors[i * 3 + 1] = g * fade;
        colors[i * 3 + 2] = b * fade;
      }
      geometry.attributes.color.needsUpdate = true;

      const glowMaterial = new THREE.LineBasicMaterial({
        vertexColors: true,
        transparent: true,
        opacity: 0.2,
        depthWrite: false,
      });
      const coreMaterial = new THREE.LineBasicMaterial({
        vertexColors: true,
        transparent: true,
        opacity: 0.95,
        depthWrite: false,
      });

      const glowTop = new THREE.Line(geometry, glowMaterial);
      const glowBottom = new THREE.Line(geometry, glowMaterial);
      const core = new THREE.Line(geometry, coreMaterial);
      glowTop.position.set(0, 0.018, index * 0.05);
      glowBottom.position.set(0, -0.018, index * 0.05);
      core.position.z = index * 0.05 + 0.01;
      scene.add(glowTop, glowBottom, core);

      return { config, geometry, glowMaterial, coreMaterial };
    });

    const updatePositions = (geometry, config, time) => {
      const positions = geometry.attributes.position.array;
      const breath = Math.max(
        0.2,
        0.64 + 0.22 * Math.sin(time * 0.68 + config.ph * 0.2) + 0.14 * Math.sin(time * 1.41 + config.ph * 0.5)
      );
      for (let i = 0; i <= segments; i += 1) {
        const u = i / segments;
        const x = u * 2 - 1;
        positions[i * 3] = x;
        positions[i * 3 + 1] = Math.sin(x * Math.PI * config.freq + config.ph + time * config.sp) * config.amp * breath * dome(x);
        positions[i * 3 + 2] = 0;
      }
      geometry.attributes.position.needsUpdate = true;
    };

    const resize = () => {
      const rect = canvas.getBoundingClientRect();
      if (rect.width > 0 && rect.height > 0) {
        renderer.setSize(rect.width, rect.height, false);
      }
    };

    const observer = new ResizeObserver(resize);
    observer.observe(canvas);
    resize();

    let frame = 0;
    const draw = (now) => {
      waveData.forEach(({ geometry, config }) => updatePositions(geometry, config, now * 0.001));
      renderer.render(scene, camera);
    };
    const tick = (now) => {
      frame = window.requestAnimationFrame(tick);
      draw(now);
    };
    draw(performance.now());
    frame = window.requestAnimationFrame(tick);

    window.addEventListener("beforeunload", () => {
      window.cancelAnimationFrame(frame);
      observer.disconnect();
      waveData.forEach(({ geometry, glowMaterial, coreMaterial }) => {
        geometry.dispose();
        glowMaterial.dispose();
        coreMaterial.dispose();
      });
      renderer.dispose();
    }, { once: true });
  };

  domeWaveCanvases.forEach(setupDomeWave);

  (() => {
    const demos = document.querySelectorAll("[data-friday-demo]");

    demos.forEach((demo) => {
      const tabs = Array.from(demo.querySelectorAll("[data-demo-state]"));
      const form = demo.querySelector("[data-composer]");
      const input = demo.querySelector("[data-chat-input]");
      const userMessage = demo.querySelector("[data-user-message]");
      const summary = demo.querySelector("[data-assistant-summary]");
      const toggle = demo.querySelector("[data-reasoning-toggle]");
      const thoughtPanel = demo.querySelector("[data-thought-panel]");
      const timer = demo.querySelector("[data-recording-time]");
      const title = demo.querySelector("[data-window-title]");
      const getStarted = demo.querySelector("[data-get-started]");
      const skipSetup = demo.querySelector("[data-skip-setup]");
      let elapsed = 13;

      const formatTime = (seconds) => {
        const minutes = Math.floor(seconds / 60);
        const remaining = String(seconds % 60).padStart(2, "0");
        return `${minutes}:${remaining}`;
      };

      const setMode = (mode) => {
        demo.dataset.state = mode;
        if (title) {
          title.textContent = mode === "setup" ? "Set up Friday" : "Friday";
        }
        tabs.forEach((tab) => {
          const selected = tab.dataset.demoState === mode;
          tab.setAttribute("aria-selected", selected ? "true" : "false");
        });
      };

      tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          setMode(tab.dataset.demoState);
        });
      });

      getStarted?.addEventListener("click", () => setMode("recording"));
      skipSetup?.addEventListener("click", () => setMode("recording"));

      toggle?.addEventListener("click", () => {
        const expanded = toggle.getAttribute("aria-expanded") === "true";
        toggle.setAttribute("aria-expanded", expanded ? "false" : "true");
        if (thoughtPanel) {
          thoughtPanel.hidden = expanded;
        }
      });

      form?.addEventListener("submit", (event) => {
        event.preventDefault();
        const message = input?.value.trim() || "Hello";
        userMessage.textContent = message;
        summary.textContent = message.toLowerCase().includes("script")
          ? "I ran the scripts in the workspace. Here are the results:"
          : "I can take that from here. I kept the workspace context visible and ready for review:";
        setMode("text");
      });

      window.setInterval(() => {
        if (demo.dataset.state !== "recording" || !timer) return;
        elapsed += 1;
        timer.textContent = formatTime(elapsed);
      }, 1000);
    });
  })();
</script>
