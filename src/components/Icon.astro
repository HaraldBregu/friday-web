---
import {
  Apple,
  ArrowRight,
  ArrowUp,
  BookOpen,
  Bot,
  CalendarDays,
  Check,
  CheckCircle2,
  ChevronDown,
  ChevronRight,
  Cloud,
  Copy,
  Cpu,
  Database,
  Download,
  Fingerprint,
  Github,
  GitBranch,
  HeartHandshake,
  Mail,
  MailCheck,
  MessageSquare,
  MessagesSquare,
  Mic,
  Moon,
  MonitorDown,
  PlugZap,
  Plus,
  RadioTower,
  ShieldCheck,
  Slack,
  Sparkles,
  Sun,
  TerminalSquare,
  Twitter,
  UserRound,
  Users,
  Workflow,
  X,
} from "lucide-astro";

const icons = {
  Apple,
  ArrowRight,
  ArrowUp,
  BookOpen,
  Bot,
  CalendarDays,
  Check,
  CheckCircle2,
  ChevronDown,
  ChevronRight,
  Cloud,
  Copy,
  Cpu,
  Database,
  Download,
  Fingerprint,
  Github,
  GitBranch,
  HeartHandshake,
  Mail,
  MailCheck,
  MessageSquare,
  MessagesSquare,
  Mic,
  Moon,
  MonitorDown,
  PlugZap,
  Plus,
  RadioTower,
  ShieldCheck,
  Slack,
  Sparkles,
  Sun,
  TerminalSquare,
  Twitter,
  UserRound,
  Users,
  Workflow,
  X,
};

const { name = "Sparkles", size = 22, strokeWidth = 1.9 } = Astro.props;
const className = Astro.props.class ?? "";
const SelectedIcon = icons[name as keyof typeof icons] ?? Sparkles;
---

<SelectedIcon aria-hidden="true" class={className} size={size} strokeWidth={strokeWidth} />
