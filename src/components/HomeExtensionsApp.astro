---
import Icon from "./Icon.astro";

interface ExtensionScreen {
  id: "workspace" | "design" | "coding";
  icon: string;
  title: string;
  status: string;
  prompt: string;
  items: string[];
}

interface Labels {
  windowLabel: string;
  screenLabel: string;
}

interface ChromeLabels {
  history: string;
  profile: string;
  attach: string;
  voice: string;
}

interface Props {
  screens: ExtensionScreen[];
  labels: Labels;
  chromeLabels: ChromeLabels;
}

const { screens, labels, chromeLabels } = Astro.props;
---

<section class="fr-home-extension-gallery" aria-label={labels.windowLabel}>
  <div class="fr-home-extension-gallery__glow" aria-hidden="true"></div>
  <div class="fr-home-extension-gallery__grid">
    {screens.map((screen) => (
      <article
        class={`fr-showcase-app fr-extension-screen is-${screen.id}`}
        aria-label={`${screen.title} — ${labels.screenLabel}`}
      >
        <header class="fr-showcase-app__bar">
          <span class="fr-window-dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <strong>Friday</strong>
          <span class="fr-showcase-app__actions">
            <i aria-label={chromeLabels.history}><Icon name="History" size={15} /></i>
            <i aria-label={chromeLabels.profile}><Icon name="UserRound" size={15} /></i>
          </span>
        </header>

        <div class="fr-showcase-app__body fr-extension-screen__body">
          <div class="fr-extension-screen__workspace">
            <header class="fr-extension-screen__head">
              <span><Icon name={screen.icon} size={17} /></span>
              <div><strong>{screen.title}</strong><small>{screen.status}</small></div>
              <Icon name="ChevronDown" size={14} />
            </header>

            {screen.id === "workspace" && (
              <div class="fr-extension-workspace-ui">
                <div class="fr-extension-workspace-ui__board">
                  <div class="fr-extension-workspace-ui__progress"><i></i><i></i><i></i><i></i><i></i></div>
                  <ul>
                    {screen.items.map((item, index) => (
                      <li><span class:list={{ "is-complete": index < 2 }}><Icon name={index < 2 ? "Check" : "Clock"} size={12} /></span><strong>{item}</strong><small>0{index + 1}</small></li>
                    ))}
                  </ul>
                </div>
              </div>
            )}

            {screen.id === "design" && (
              <div class="fr-extension-design-ui">
                <div class="fr-extension-design-ui__tools" aria-hidden="true">
                  <span class="is-active"><Icon name="MousePointer2" size={13} /></span>
                  <span><Icon name="Square" size={13} /></span>
                  <span><Icon name="Type" size={13} /></span>
                  <span><Icon name="Pencil" size={13} /></span>
                </div>
                <div class="fr-extension-design-ui__canvas">
                  <div class="fr-extension-design-ui__art" aria-hidden="true"><i></i><i></i><i></i><strong>FRIDAY</strong></div>
                  <div class="fr-extension-design-ui__layers">
                    {screen.items.map((item, index) => <span class:list={{ "is-active": index === 0 }}><i></i>{item}</span>)}
                  </div>
                </div>
              </div>
            )}

            {screen.id === "coding" && (
              <div class="fr-extension-coding-ui">
                <div class="fr-extension-coding-ui__editor" aria-label={screen.title}>
                  <header>
                    {screen.items.map((item, index) => (
                      <span class:list={{ "is-active": index === screen.items.length - 1 }}>
                        <Icon name={index === screen.items.length - 1 ? "ScanText" : "Folder"} size={11} />{item}
                      </span>
                    ))}
                  </header>
                  <ol>
                    <li><span>const</span> friday = <em>createAssistant</em>();</li>
                    <li>friday.<em>use</em>(workspace);</li>
                    <li>friday.<em>run</em>({`{`}</li>
                    <li>&nbsp;&nbsp;mode: <q>"focused"</q>,</li>
                    <li>&nbsp;&nbsp;tools: <q>"enabled"</q></li>
                    <li>{`}`});</li>
                  </ol>
                  <footer><Icon name="TerminalSquare" size={12} /><span>✓ build complete</span></footer>
                </div>
              </div>
            )}
          </div>

          {screen.id !== "coding" && (
            <div class="fr-showcase-composer fr-extension-screen__composer">
              <span aria-label={chromeLabels.attach}><Icon name="Plus" size={15} /></span>
              <p>{screen.prompt}</p>
              <strong aria-label={chromeLabels.voice}><Icon name="AudioLines" size={16} /></strong>
            </div>
          )}
        </div>
      </article>
    ))}
  </div>
</section>
