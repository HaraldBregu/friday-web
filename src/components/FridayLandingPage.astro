---
import FridayLandingNav from "./FridayLandingNav.astro";
import DocumentationPreview from "./DocumentationPreview.astro";
import Icon from "./Icon.astro";
import ProductMockup from "./ProductMockup.astro";
import landingEn from "../data/friday-landing.json";
import landingIt from "../data/friday-landing-it.json";
import { normalizeLocale, type Locale } from "../i18n";
import "../styles/friday-landing.css";

interface Props {
  locale?: Locale;
}

const locale = normalizeLocale(Astro.props.locale);
const landing = locale === "it" ? landingIt : landingEn;
const {
  capabilities,
  copy,
  controlPoints,
  extensionPoints,
  foundationSteps,
  knowledgeBasePoints,
  knowledgeComparison,
  links,
  skillPoints,
  wikiPoints,
} = landing;
---

<FridayLandingNav locale={locale} />

<section class="fr-hero" id="product">
  <div class="fr-shell fr-hero__layout">
    <div class="fr-hero__copy">
      <p class="fr-eyebrow"><span></span>{copy.hero.eyebrow}</p>
      <h1>{copy.hero.title}</h1>
      <p class="fr-hero__lede">{copy.hero.description}</p>
      <div class="fr-actions">
        <a class="fr-button" href={links.download} target="_blank" rel="noopener noreferrer">
          <Icon name="Download" size={17} />
          {copy.hero.download}
        </a>
        <a class="fr-button fr-button--secondary" href={links.github} target="_blank" rel="noopener noreferrer">
          <Icon name="Github" size={17} />
          {copy.hero.github}
        </a>
      </div>
      <p class="fr-hero__note">
        <Icon name="ShieldCheck" size={16} />
        {copy.hero.note}
      </p>
    </div>

    <div class="fr-hero__visual">
      <div class="fr-hero__glow" aria-hidden="true"></div>
      <div class="fr-chat-preview">
        <ProductMockup landingWorkflow locale={locale} />
      </div>
    </div>

    <ul class="fr-capabilities" aria-label={copy.hero.capabilitiesLabel}>
      {capabilities.map((capability) => (
        <li><span><Icon name={capability.icon} size={15} /></span>{capability.label}</li>
      ))}
    </ul>
  </div>
</section>

<section class="fr-section fr-foundation" aria-labelledby="foundation-title">
  <div class="fr-shell">
    <header class="fr-section-head fr-section-head--split" data-reveal>
      <div>
        <p class="fr-eyebrow"><span></span>{copy.foundation.eyebrow}</p>
        <h2 id="foundation-title">{copy.foundation.title}</h2>
      </div>
      <p>{copy.foundation.description}</p>
    </header>

    <ol class="fr-flow" data-reveal>
      {foundationSteps.map((step, index) => (
        <li>
          <div class="fr-flow__top">
            <span><Icon name={step.icon} size={18} /></span>
            <code>{step.number}</code>
          </div>
          <h3>{step.title}</h3>
          <p>{step.description}</p>
          <ul class="fr-flow__surfaces" aria-label={`${step.title}: ${copy.foundation.surfacesLabel}`}>
            {step.surfaces.map((surface) => <li>{surface}</li>)}
          </ul>
          {index < foundationSteps.length - 1 ? <Icon class="fr-flow__arrow" name="ArrowRight" size={17} /> : null}
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="fr-section fr-feature-section" id="skills" aria-labelledby="skills-title">
  <div class="fr-shell fr-feature-layout fr-feature-layout--text">
    <div class="fr-feature-copy" data-reveal>
      <p class="fr-eyebrow"><span></span>{copy.skills.eyebrow}</p>
      <h2 id="skills-title">{copy.skills.title}</h2>
      <p class="fr-section-lede">{copy.skills.description}</p>
      <ul class="fr-check-list">
        {skillPoints.map((point) => <li><Icon name="Check" size={14} /><span>{point}</span></li>)}
      </ul>
      <aside class="fr-callout">
        <span><Icon name="Sparkles" size={17} /></span>
        <p>{copy.skills.callout}</p>
      </aside>
    </div>
  </div>
</section>

<section class="fr-section fr-knowledge" id="knowledge" aria-labelledby="knowledge-title">
  <div class="fr-shell">
    <header class="fr-section-head fr-section-head--center" data-reveal>
      <p class="fr-eyebrow"><span></span>{copy.knowledge.eyebrow}</p>
      <h2 id="knowledge-title">{copy.knowledge.title}</h2>
      <p>{copy.knowledge.description}</p>
    </header>

    <div class="fr-knowledge-panels">
      <article class="fr-knowledge-card fr-knowledge-card--rag" data-reveal>
        <div class="fr-card-label"><span><Icon name="Search" size={17} /></span>Knowledge Base</div>
        <h3>{copy.knowledge.baseTitle}</h3>
        <p>{copy.knowledge.baseDescription}</p>
        <span class="fr-tech-label">{copy.knowledge.baseTech}</span>
        <ul class="fr-check-list">
          {knowledgeBasePoints.map((point) => <li><Icon name="Check" size={14} /><span>{point}</span></li>)}
        </ul>
      </article>

      <article class="fr-knowledge-card fr-knowledge-card--wiki" data-reveal>
        <div class="fr-card-label"><span><Icon name="BookOpen" size={17} /></span>LLM Wiki</div>
        <h3>{copy.knowledge.wikiTitle}</h3>
        <p>{copy.knowledge.wikiDescription}</p>
        <span class="fr-tech-label">{copy.knowledge.wikiTech}</span>
        <ul class="fr-check-list">
          {wikiPoints.map((point) => <li><Icon name="Check" size={14} /><span>{point}</span></li>)}
        </ul>
      </article>
    </div>

    <aside class="fr-callout fr-callout--wide" data-reveal>
      <span><Icon name="GitBranch" size={18} /></span>
      <p>{copy.knowledge.callout}</p>
    </aside>

    <div class="fr-comparison" data-reveal>
      <div class="fr-comparison__head">
        <div><p class="fr-kicker">{copy.knowledge.comparisonEyebrow}</p><h3>{copy.knowledge.comparisonTitle}</h3></div>
        <span><Icon name="GitBranch" size={17} /> {copy.knowledge.comparisonStatus}</span>
      </div>
      <table>
        <thead>
          <tr><th scope="col">&nbsp;</th><th scope="col">Knowledge Base</th><th scope="col">LLM Wiki</th></tr>
        </thead>
        <tbody>
          {knowledgeComparison.map((row) => (
            <tr>
              <th scope="row">{row.label}</th>
              <td data-label="Knowledge Base">{row.knowledgeBase}</td>
              <td data-label="LLM Wiki">{row.wiki}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<section class="fr-section fr-feature-section fr-feature-section--reverse" id="extensions" aria-labelledby="extensions-title">
  <div class="fr-shell fr-feature-layout fr-feature-layout--text">
    <div class="fr-feature-copy" data-reveal>
      <p class="fr-eyebrow"><span></span>{copy.extensions.eyebrow}</p>
      <h2 id="extensions-title">{copy.extensions.title}</h2>
      <p class="fr-section-lede">{copy.extensions.description}</p>
      <ul class="fr-check-list">
        {extensionPoints.map((point) => <li><Icon name="Check" size={14} /><span>{point}</span></li>)}
      </ul>
      <aside class="fr-trust-note">
        <Icon name="ShieldCheck" size={17} />
        <p><strong>{copy.extensions.trustTitle}</strong> {copy.extensions.trustDescription}</p>
      </aside>
    </div>
  </div>
</section>

<section class="fr-section fr-control" id="control" aria-labelledby="control-title">
  <div class="fr-shell">
    <header class="fr-section-head fr-section-head--center" data-reveal>
      <p class="fr-eyebrow"><span></span>{copy.control.eyebrow}</p>
      <h2 id="control-title">{copy.control.title}</h2>
      <p>{copy.control.description}</p>
    </header>

    <div class="fr-control-layout fr-control-layout--text">
      <ul class="fr-control-points" data-reveal>
        {controlPoints.map((point, index) => (
          <li><span><code>0{index + 1}</code><Icon name={index === 0 ? "ShieldCheck" : index === 1 ? "Fingerprint" : index === 2 ? "Eye" : index === 3 ? "Monitor" : "Globe"} size={17} /></span><p>{point}</p></li>
        ))}
      </ul>
    </div>

    <aside class="fr-disclosure" data-reveal>
      <span><Icon name="Globe" size={19} /></span>
      <div>
        <strong>{copy.control.disclosureTitle}</strong>
        <p>{copy.control.disclosure}</p>
      </div>
    </aside>
  </div>
</section>

<div class="fr-docs-preview">
  <DocumentationPreview locale={locale} />
</div>

<section class="fr-final-cta" aria-labelledby="final-cta-title">
  <div class="fr-final-cta__glow" aria-hidden="true"></div>
  <div class="fr-shell fr-final-cta__inner" data-reveal>
    <img src="/icon-rounded.png" width="74" height="74" alt="" />
    <p class="fr-eyebrow"><span></span>{copy.cta.eyebrow}</p>
    <h2 id="final-cta-title">{copy.cta.title}</h2>
    <p>{copy.cta.description}</p>
    <div class="fr-actions">
      <a class="fr-button" href={links.download} target="_blank" rel="noopener noreferrer"><Icon name="Download" size={17} />{copy.cta.download}</a>
      <a class="fr-button fr-button--secondary" href={links.github} target="_blank" rel="noopener noreferrer"><Icon name="Github" size={17} />{copy.cta.source}</a>
    </div>
    <span class="fr-platform-line"><Icon name="Monitor" size={15} />{copy.cta.platforms}</span>
  </div>
</section>

<script is:inline>
  (() => {
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduceMotion || !("IntersectionObserver" in window)) return;

    const items = document.querySelectorAll("[data-reveal]");
    document.documentElement.classList.add("fr-motion-ready");
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add("is-visible");
        observer.unobserve(entry.target);
      });
    }, { rootMargin: "0px 0px -8%", threshold: 0.08 });
    items.forEach((item) => observer.observe(item));
  })();
</script>
