---
import CTASection from "../components/CTASection.astro";
import Icon from "../components/Icon.astro";
import operators from "../data/operators.json";
import Layout from "../layouts/Layout.astro";

const statusLabel: Record<string, string> = {
  implemented: "Live",
  "pending-runtime": "Coming soon",
  "placeholder": "Planned",
};

const statusClass: Record<string, string> = {
  implemented: "badge--green",
  "pending-runtime": "badge--yellow",
  "placeholder": "badge--muted",
};
---

<Layout
  title="Operators"
  description="Friday's AI operators — speech, text-to-speech, image, video, music, OCR, cron scheduling, and background tasks."
>
  <section class="section page-hero">
    <div class="shell section-heading">
      <p class="eyebrow">Operators</p>
      <h1>Every AI job, routed to the right model.</h1>
      <p>
        Friday separates concerns. Each operator owns one kind of work —
        voice, images, video, music, or scheduling — and resolves its own
        provider and model from your saved settings.
      </p>
    </div>
  </section>

  <section class="section section--compact">
    <div class="shell">
      <div class="operator-grid">
        {
          operators.map((op) => (
            <article class="operator-card">
              <div class="operator-card__header">
                <div class="card-icon">
                  <Icon name={op.icon} />
                </div>
                <span class={`badge ${statusClass[op.status] ?? "badge--muted"}`}>
                  {statusLabel[op.status] ?? op.status}
                </span>
              </div>
              <h2>{op.name}</h2>
              <p class="operator-card__desc">{op.description}</p>

              <ul class="operator-card__highlights">
                {op.highlights.map((h) => (
                  <li>
                    <Icon name="Check" size={14} />
                    <span>{h}</span>
                  </li>
                ))}
              </ul>

              <div class="operator-card__providers">
                <p class="label-xs">Supported providers</p>
                <p class="provider-list">{op.providers.join(" · ")}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <CTASection
    eyebrow="Bring your own provider"
    title="Every operator is provider-agnostic."
    description="Configure your preferred provider and model in Settings. Credentials stay local; the operator resolves them at runtime."
  />
</Layout>

<style>
  .operator-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 1.25rem;
  }

  .operator-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .operator-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .operator-card h2 {
    font-size: 1.05rem;
    font-weight: 600;
    margin: 0;
    line-height: 1.3;
  }

  .operator-card__desc {
    font-size: 0.875rem;
    color: var(--muted);
    line-height: 1.6;
    margin: 0;
  }

  .operator-card__highlights {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    border-top: 1px solid var(--line);
    padding-top: 0.75rem;
    margin-top: 0.25rem;
  }

  .operator-card__highlights li {
    display: flex;
    align-items: flex-start;
    gap: 0.45rem;
    font-size: 0.8125rem;
    color: var(--muted);
    line-height: 1.5;
  }

  .operator-card__highlights li :global(svg) {
    flex-shrink: 0;
    margin-top: 3px;
    color: var(--green);
  }

  .operator-card__providers {
    border-top: 1px solid var(--line);
    padding-top: 0.75rem;
    margin-top: auto;
  }

  .label-xs {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--faint);
    margin: 0 0 0.3rem;
  }

  .provider-list {
    font-size: 0.8rem;
    color: var(--muted);
    margin: 0;
    line-height: 1.5;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.2em 0.55em;
    border-radius: 4px;
  }

  .badge--green {
    background: rgba(120, 212, 184, 0.15);
    color: var(--green);
  }

  .badge--yellow {
    background: rgba(245, 191, 79, 0.15);
    color: var(--yellow);
  }

  .badge--muted {
    background: var(--surface-strong);
    color: var(--faint);
  }

  @media (max-width: 640px) {
    .operator-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
