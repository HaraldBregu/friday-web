---
import { getCollection } from "astro:content";
import DocCard from "../../components/DocCard.astro";
import Icon from "../../components/Icon.astro";
import Layout from "../../layouts/Layout.astro";
import { categoryIcons, categoryId, docsPath, groupDocs } from "../../lib/docs";

const docs = await getCollection("docs");
const groups = groupDocs(docs);
const categoryCount = groups.length;
const indexDocs = groups
  .map((group) => group.items.find((doc) => doc.data.sourcePath.endsWith("/index.md")) ?? group.items[0])
  .filter((doc): doc is NonNullable<typeof doc> => Boolean(doc));
const primaryDoc = indexDocs[0];
const secondaryDocs = indexDocs.slice(1, 4);
---

<Layout
  title="Documentation"
  description="Browse Friday documentation for the desktop AI assistant, providers, tools, channels, automation, memory, privacy, and getting started."
  wide={true}
>
  <section class="section page-hero docs-hero">
    <div class="shell docs-hero__inner">
      <div class="section-heading">
        <p class="eyebrow">Documentation</p>
        <h1>Friday product documentation</h1>
        <p>
          Start with what Friday is, then explore the assistant, tools,
          providers, channels, and automation.
        </p>
        <div class="docs-hero__actions" aria-label="Documentation quick links">
          <a class="button button--primary" href={primaryDoc ? docsPath(primaryDoc.data.sourcePath) : "#start-here"}>
            Start reading
            <Icon name="ArrowRight" size={16} />
          </a>
          <a class="button button--ghost" href="#browse-sections">Browse sections</a>
        </div>
      </div>
      <div class="docs-hero__stats" aria-label="Documentation summary">
        <div>
          <strong>{docs.length}</strong>
          <span>pages synced</span>
        </div>
        <div>
          <strong>{categoryCount}</strong>
          <span>sections</span>
        </div>
        <div>
          <strong>Static</strong>
          <span>Astro content</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--compact" id="browse-sections">
    <div class="shell docs-section-grid" aria-label="Documentation sections">
      {
        groups.map((group) => (
          <a class="docs-section-tile" href={`#${categoryId(group.category)}`}>
            <span class="docs-section-tile__icon">
              <Icon name={categoryIcons[group.category] ?? "BookOpen"} size={18} />
            </span>
            <span>
              <strong>{group.category}</strong>
              <small>{group.items.length} {group.items.length === 1 ? "page" : "pages"}</small>
            </span>
            <Icon name="ArrowRight" size={14} />
          </a>
        ))
      }
    </div>
  </section>

  <section class="section section--compact" id="start-here">
    <div class="shell">
      <header class="docs-group-head">
        <Icon name="BookOpen" size={18} />
        <h2>Start Here</h2>
        <span>{indexDocs.length} section guides</span>
      </header>
      <div class="docs-start-grid">
        {
          primaryDoc ? (
            <a class="docs-featured-guide" href={docsPath(primaryDoc.data.sourcePath)}>
              <span class="docs-featured-guide__label">
                <Icon name={categoryIcons[primaryDoc.data.category] ?? "BookOpen"} size={16} />
                Recommended first read
              </span>
              <strong>{primaryDoc.data.title}</strong>
              <span>{primaryDoc.data.description}</span>
              <span class="doc-card__link">
                Open guide
                <Icon name="ArrowRight" size={14} />
              </span>
            </a>
          ) : null
        }
        <div class="docs-start-list">
          {
            secondaryDocs.map((doc) => (
              <DocCard
                title={doc.data.title}
                description={doc.data.description}
                href={docsPath(doc.data.sourcePath)}
                category={doc.data.category}
                icon={categoryIcons[doc.data.category] ?? "BookOpen"}
              />
            ))
          }
        </div>
      </div>
    </div>
  </section>

  {
    groups.map((group) => (
      <section class="section section--compact docs-group-section" id={group.id}>
        <div class="shell">
          <header class="docs-group-head">
            <Icon name={group.icon} size={18} />
            <h2>{group.category}</h2>
            <span>{group.items.length} {group.items.length === 1 ? "page" : "pages"}</span>
          </header>
          <div class="docs-card-grid">
            {group.items.map((doc) => (
              <DocCard
                title={doc.data.title}
                description={doc.data.description}
                href={docsPath(doc.data.sourcePath)}
                category={doc.data.category}
                icon={group.icon}
              />
            ))}
          </div>
        </div>
      </section>
    ))
  }
</Layout>
