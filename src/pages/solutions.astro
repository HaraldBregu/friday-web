---
import CTASection from "../components/CTASection.astro";
import Icon from "../components/Icon.astro";
import Layout from "../layouts/Layout.astro";

const audiences = [
  {
    id: "enterprise",
    icon: "Users",
    eyebrow: "Enterprise",
    title: "Coordinate work across the organization.",
    description: "Run reliable AI-assisted operations across teams and workflows.",
    groups: [
      { title: "Workflow & process management", items: ["Map, manage, and optimize internal processes.", "Identify bottlenecks and suggest workflow improvements.", "Run long-running and recurring work in the background.", "Monitor systems, agents, and workflows with health checks."] },
      { title: "AI agents & tooling", items: ["Customize MCP servers for company systems.", "Provide dedicated tools for sales, support, HR, engineering, operations, and finance.", "Build, install, and reuse custom skills.", "Enable task-specific agents with clear roles and permissions."] },
      { title: "Collaboration & memory", items: ["Share memory between users, teams, and agents.", "Set company-wide, team, and project-specific memory scopes.", "Support user-to-agent and agent-to-agent communication for coordinated workflows."] },
      { title: "Admin & control", items: ["Manage permissions for users, teams, agents, tools, and memories.", "Keep audit logs for agent actions and background tasks.", "Meet compliance, security, and data-governance requirements."] },
    ],
  },
  {
    id: "education",
    icon: "BookOpen",
    eyebrow: "Education",
    title: "Turn ideas into finished projects.",
    description: "A practical AI workspace for building, sharing, and learning.",
    groups: [
      { title: "Project building", items: ["Help students build projects from idea to completion.", "Provide templates for coding, research, presentations, and assignments.", "Organize milestones, tasks, notes, and resources."] },
      { title: "Sharing & collaboration", items: ["Share projects with classmates, teachers, and mentors.", "Create collaborative workspaces for group projects.", "Support feedback, comments, and version history."] },
      { title: "Customization", items: ["Customize workspaces, agents, tools, and learning preferences.", "Provide personalized study plans and project guidance."] },
    ],
  },
  {
    id: "personal",
    icon: "UserRound",
    eyebrow: "Personal",
    title: "Keep your context with you.",
    description: "One assistant for everyday plans, family coordination, and long-term goals.",
    groups: [
      { title: "Household coordination", items: ["Manage shared tasks, schedules, chores, shopping lists, and appointments.", "Keep a shared memory for preferences, routines, important dates, and recurring needs.", "Set appropriate permissions for parents, children, and other family members."] },
      { title: "Planning & reminders", items: ["Schedule recurring household reminders.", "Coordinate calendars, trips, meal planning, and budget tracking.", "Share responsibilities across family members."] },
      { title: "Cross-device continuity", items: ["Keep the same personal brain and memory across devices.", "Resume tasks from phone, laptop, tablet, or desktop.", "Sync preferences, history, projects, files, and context."] },
      { title: "Personal productivity", items: ["Manage goals, tasks, routines, and long-term projects.", "Automate reminders, research, monitoring, and recurring summaries.", "Customize personal agents for work, learning, health, finance, and daily planning."] },
    ],
  },
];
---

<Layout
  canonical="/solutions"
  title="Solutions"
  description="Where Friday is headed for enterprise teams, education, and personal use — one capability map per audience."
  image="/og/solutions.png"
>
  <section class="audience-hero">
    <div class="shell audience-intro">
      <p class="eyebrow">Solutions</p>
      <h1>Built for how you <em>work.</em></h1>
      <p class="lede">
        The same desktop agent, mapped to three ways people use it. Every area below is product direction, designed
        around useful automation and permissioned actions.
      </p>
      <nav class="audience-jump" aria-label="Jump to an audience">
        {audiences.map((audience) => (
          <a href={`#${audience.id}`}>
            <Icon name={audience.icon} size={16} />
            {audience.eyebrow}
          </a>
        ))}
      </nav>
    </div>
  </section>

  {
    audiences.map((audience) => (
      <section class="section reference-section audience-capabilities" id={audience.id}>
        <div class="shell">
          <header class="audience-section-head">
            <span class="audience-icon"><Icon name={audience.icon} size={22} /></span>
            <span class="section-tag">Friday for {audience.eyebrow}</span>
            <h2>{audience.title}</h2>
            <p>{audience.description}</p>
          </header>
          <div class="audience-groups">
            {audience.groups.map((group, index) => (
              <article class="audience-group">
                <div class="audience-group__top">
                  <span>AREA {String(index + 1).padStart(2, "0")}</span>
                  <Icon name={audience.icon} size={18} />
                </div>
                <h3>{group.title}</h3>
                <ul>
                  {group.items.map((item) => <li><Icon name="Check" size={16} />{item}</li>)}
                </ul>
              </article>
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <CTASection
    eyebrow="Product direction"
    title="A roadmap built around useful coordination."
    description="Friday is designed to automate meaningful work while preserving clear permissions and human control."
  />
</Layout>

<style>
  .audience-hero { padding: clamp(5rem, 11vw, 8rem) 0 clamp(2.5rem, 6vw, 4rem); }
  .audience-intro { display: flex; flex-direction: column; align-items: center; max-width: 850px; text-align: center; }
  .audience-intro h1 { max-width: 14ch; margin: 0 0 1.25rem; font-size: clamp(3.2rem, 8vw, 6.5rem); line-height: 0.96; letter-spacing: -0.05em; }
  .audience-intro .lede { max-width: 60ch; margin: 0; }
  .audience-jump { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; margin-top: 2.25rem; }
  .audience-jump a { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.55rem 1.1rem; border: 1px solid var(--line); border-radius: 999px; color: var(--text); font-size: 0.9rem; text-decoration: none; }
  .audience-jump a:hover { border-color: var(--accent); color: var(--accent); }
  .audience-jump svg { color: var(--accent); }
  .audience-capabilities { padding-top: 0; scroll-margin-top: 84px; }
  .audience-section-head { display: flex; flex-direction: column; align-items: center; max-width: 680px; margin: 0 auto 3.5rem; padding-top: 3.5rem; text-align: center; }
  .audience-icon { display: grid; width: 48px; height: 48px; place-items: center; margin-bottom: 1.1rem; border: 1px solid var(--line-strong); border-radius: 50%; background: var(--accent-soft); color: var(--accent); }
  .audience-section-head h2 { margin: 0.75rem 0 0; font-size: clamp(2.2rem, 5vw, 3.6rem); letter-spacing: -0.04em; line-height: 1.02; }
  .audience-section-head p { max-width: 52ch; margin: 1.25rem 0 0; color: var(--muted); }
  .audience-groups { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem; }
  .audience-group { display: flex; flex-direction: column; min-height: 100%; padding-top: 1.25rem; }
  .audience-group__top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; color: var(--faint); font-family: var(--font-mono); font-size: 0.76rem; font-weight: 700; letter-spacing: 0.06em; }
  .audience-group__top svg { color: var(--accent); }
  .audience-group h3 { margin: 0 0 1.2rem; font-size: 1.35rem; letter-spacing: -0.025em; }
  .audience-group ul { display: grid; gap: 0.75rem; margin: 0; padding: 0; list-style: none; }
  .audience-group li { display: flex; align-items: flex-start; gap: 0.6rem; color: var(--text-soft); font-size: 0.94rem; line-height: 1.55; }
  .audience-group li svg { flex: 0 0 auto; margin-top: 0.22rem; color: var(--accent); }
  @media (max-width: 620px) { .audience-groups { grid-template-columns: 1fr; gap: 2.25rem; } .audience-section-head { margin-bottom: 2.5rem; } }
</style>
