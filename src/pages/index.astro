---
import CTASection from "../components/CTASection.astro";
import FeatureCard from "../components/FeatureCard.astro";
import Hero from "../components/Hero.astro";
import Icon from "../components/Icon.astro";
import IntegrationCard from "../components/IntegrationCard.astro";
import TestimonialCard from "../components/TestimonialCard.astro";
import features from "../data/features.json";
import integrations from "../data/integrations.json";
import press from "../data/press.json";
import site from "../data/site.json";
import testimonials from "../data/testimonials.json";
import Layout from "../layouts/Layout.astro";

const featuredIntegrations = integrations.slice(0, 6);
---

<Layout title={site.name} description={site.description}>
  <Hero />

  <section aria-label="Social proof" class="proof-strip">
    <div class="shell proof-strip__inner">
      <span>For teams replacing status meetings with visible work</span>
      <span>Developer-first</span>
      <span>Static-site fast</span>
      <span>Open-source ready</span>
    </div>
  </section>

  <section class="section" id="features">
    <div class="shell section-heading">
      <p class="eyebrow">Core features</p>
      <h2>Everything needed to turn intent into shipped work.</h2>
      <p>
        The product surface is intentionally small. The capability comes from
        context, provider routing, connected tools, and reviewable actions.
      </p>
    </div>
    <div class="shell feature-grid">
      {features.map((feature) => <FeatureCard feature={feature} />)}
    </div>
  </section>

  <section class="section section--muted">
    <div class="shell section-heading">
      <p class="eyebrow">How it works</p>
      <h2>Connect, ask, approve.</h2>
    </div>
    <div class="shell steps">
      <article>
        <span>01</span>
        <h3>Connect trusted systems</h3>
        <p>Add model providers, repositories, channels, and scoped credentials.</p>
      </article>
      <article>
        <span>02</span>
        <h3>Describe the outcome</h3>
        <p>Ask in plain language. Friday breaks the work into inspectable steps.</p>
      </article>
      <article>
        <span>03</span>
        <h3>Review and ship</h3>
        <p>Approve the actions, watch progress, and send concise updates.</p>
      </article>
    </div>
  </section>

  <section class="section" id="integrations">
    <div class="shell split-heading">
      <div>
        <p class="eyebrow">Integrations</p>
        <h2>Works where your context already lives.</h2>
      </div>
      <a class="text-link" href="/integrations">
        Explore integrations
        <Icon name="ArrowRight" size={16} />
      </a>
    </div>
    <div class="shell integration-grid">
      {featuredIntegrations.map((integration) => <IntegrationCard integration={integration} />)}
    </div>
  </section>

  <section class="section section--muted">
    <div class="shell split-heading">
      <div>
        <p class="eyebrow">Community</p>
        <h2>Built with the people who run the workflows.</h2>
      </div>
      <a class="text-link" href="/community">
        Join the community
        <Icon name="ArrowRight" size={16} />
      </a>
    </div>
    <div class="shell testimonial-grid">
      {testimonials.map((testimonial) => <TestimonialCard testimonial={testimonial} />)}
    </div>
  </section>

  <section class="section">
    <div class="shell split-heading">
      <div>
        <p class="eyebrow">Updates</p>
        <h2>Recent notes from product and engineering.</h2>
      </div>
      <a class="text-link" href="/blog">
        Read the blog
        <Icon name="ArrowRight" size={16} />
      </a>
    </div>
    <div class="shell press-grid">
      {
        press.map((item) => (
          <article class="press-card">
            <span>{item.source}</span>
            <h3>
              <a href={item.url}>{item.title}</a>
            </h3>
            <p>{item.description}</p>
          </article>
        ))
      }
    </div>
  </section>

  <CTASection />
</Layout>
