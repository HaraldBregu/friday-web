---
import LandingPage from "../components/LandingPage.astro";
import { getLocaleContent } from "../i18n";
import Layout from "../layouts/Layout.astro";

const locale = "en";
const { home, site } = getLocaleContent(locale);
---

<Layout
  alternatePath="/"
  locale={locale}
  title={site.name}
  description={site.description}
  ogTitle={home.ogTitle}
  ogDescription={home.ogDescription}
>
  <LandingPage locale={locale} />
</Layout>
