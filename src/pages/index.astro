---
import FridayLandingPage from "../components/FridayLandingPage.astro";
import { buildHomepageStructuredData } from "../lib/structured-data";
import Layout from "../layouts/Layout.astro";

const locale = "en";
const title = "Friday — Desktop AI that turns knowledge into action";
const description = "Friday is a cross-platform desktop AI copilot with reusable Skills, a source-aware LLM Wiki, semantic document search, and custom Extensions.";
const siteBaseUrl = Astro.site ?? new URL("https://friday.haraldbregu.com");
const structuredData = buildHomepageStructuredData({
  description,
  featureNames: ["Tool-using desktop agent", "Reusable Agent Skills", "Semantic Knowledge Base", "Source-aware LLM Wiki", "Custom Extensions"],
  locale,
  siteBaseUrl,
  tagline: "Your desktop AI copilot for everyday tasks.",
});
---

<Layout
  alternatePath="/"
  bodyClass="friday-landing-page"
  description={description}
  exactTitle
  footerVariant="landing"
  hideBackgroundEffects
  hideHeader
  image="/og/default.png"
  imageAlt="Friday desktop AI copilot"
  locale={locale}
  ogDescription={description}
  ogTitle={title}
  structuredData={structuredData}
  title={title}
>
  <FridayLandingPage />
</Layout>
