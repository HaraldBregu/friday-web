---
import FridayLandingPage from "../components/FridayLandingPage.astro";
import { buildHomepageStructuredData } from "../lib/structured-data";
import Layout from "../layouts/Layout.astro";

const locale = "en";
const title = "Friday: A Personal Desktop AI Assistant";
const description = "Friday is a personal desktop AI assistant that remembers useful context, organizes everyday work, connects with your tools, and turns requests into results.";
const siteBaseUrl = Astro.site ?? new URL("https://friday.haraldbregu.com");
const structuredData = buildHomepageStructuredData({
  description,
  featureNames: ["Personal context and preferences", "Schedules and recurring plans", "Background tasks", "Connected tools and services", "Multi-step task completion", "Custom Extensions"],
  locale,
  siteBaseUrl,
  tagline: "A personal desktop AI assistant for everyday work.",
});
---

<Layout
  alternatePath="/"
  bodyClass="friday-landing-page"
  description={description}
  exactTitle
  footerVariant="landing"
  hideBackgroundEffects
  hideHeader
  image="/og/default.png"
  imageAlt="Friday personal desktop AI assistant"
  locale={locale}
  ogDescription={description}
  ogTitle={title}
  structuredData={structuredData}
  title={title}
>
  <FridayLandingPage />
</Layout>
