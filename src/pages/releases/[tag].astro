---
import Icon from "../../components/Icon.astro";
import ProductPageLayout from "../../layouts/ProductPageLayout.astro";
import { formatAssetSize, formatReleaseDate, releases, type Release } from "../../lib/releases";

export function getStaticPaths() {
  return releases.map((release) => ({
    params: { tag: release.tag },
    props: { release },
  }));
}

const { release } = Astro.props as { release: Release };
const publishedDate = new Date(release.publishedAt);
const shortCommit = release.commit.slice(0, 7);
const platformIcon = (platform: string) => platform === "macOS" ? "Apple" : platform === "Windows" ? "MonitorDown" : "TerminalSquare";
const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Friday",
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "macOS, Windows, Linux",
  softwareVersion: release.tag,
  datePublished: release.publishedAt,
  description: release.summary,
  codeRepository: release.sourceUrl,
  ...(release.assets.length > 0 ? { downloadUrl: release.assets.map((asset) => asset.url) } : {}),
};
---

<ProductPageLayout
  canonical={`/releases/${release.tag}`}
  description={release.summary}
  ogType="article"
  publishedTime={publishedDate}
  structuredData={structuredData}
  tags={[release.tag, "release", release.stage]}
  title={release.name}
>
  <article class="release-detail">
    <header class="product-article-hero release-detail-hero">
      <div class="shell product-article-hero__inner">
        <a class="product-back-link" href="/releases">
          <Icon name="ArrowRight" size={15} />
          Back to releases
        </a>
        <p class="catalog-eyebrow">{release.tag} / {release.stage}</p>
        <h1>{release.name}</h1>
        <p class="product-article-hero__lede">{release.summary}</p>
        <div class="product-article-meta">
          <time datetime={publishedDate.toISOString()}>{formatReleaseDate(release.publishedAt)}</time>
          <span>{release.assets.length > 0 ? `${release.assets.length} installers` : "Source tag only"}</span>
          <span>Commit {shortCommit}</span>
        </div>
        <div class="release-hero-actions">
          {
            release.assets.length > 0 ? (
              <a class="release-action release-action--primary" href="#downloads">
                <Icon name="Download" size={16} />
                Choose a download
              </a>
            ) : null
          }
          <a class="release-action" href={release.sourceUrl} target="_blank" rel="noopener noreferrer">
            <Icon name="Github" size={16} />
            Browse source
          </a>
        </div>
      </div>
    </header>

    <section class="catalog-section release-overview-section">
      <div class="shell release-overview">
        <div class="release-highlights">
          <span class="catalog-section-tag">01 / What changed</span>
          <h2>Release highlights.</h2>
          <ul>
            {release.highlights.map((highlight) => (
              <li><Icon name="Check" size={17} /><span>{highlight}</span></li>
            ))}
          </ul>
        </div>
        <aside class="release-facts" aria-label="Release details">
          <span>Release details</span>
          <dl>
            <div><dt>Version</dt><dd>{release.tag}</dd></div>
            <div><dt>Channel</dt><dd>{release.stage}</dd></div>
            <div><dt>Published</dt><dd>{formatReleaseDate(release.publishedAt, "short")}</dd></div>
            <div><dt>Commit</dt><dd><code>{shortCommit}</code></dd></div>
            <div><dt>Artifacts</dt><dd>{release.assets.length || "None"}</dd></div>
          </dl>
        </aside>
      </div>
    </section>

    {
      release.assets.length > 0 ? (
        <section class="catalog-section is-tinted" id="downloads">
          <div class="shell">
            <header class="catalog-section__head">
              <div class="catalog-section__title">
                <span class="catalog-section-tag">02 / Downloads</span>
                <h2>Choose your build.</h2>
              </div>
              <p class="catalog-section__aside">
                These files are served directly from the verified GitHub release. Choose the platform, architecture, and installer format that matches your computer.
              </p>
            </header>
            <div class="release-download-grid">
              {release.assets.map((asset) => (
                <a class="release-download" href={asset.url} target="_blank" rel="noopener noreferrer">
                  <span class="release-download__icon"><Icon name={platformIcon(asset.platform)} size={20} /></span>
                  <span class="release-download__copy">
                    <strong>{asset.platform}</strong>
                    <span>{asset.architecture} / {asset.format}</span>
                    <small>{formatAssetSize(asset.size)}</small>
                  </span>
                  <Icon class="release-download__arrow" name="Download" size={17} />
                </a>
              ))}
            </div>
          </div>
        </section>
      ) : (
        <section class="catalog-section is-tinted" id="source">
          <div class="shell release-source-notice">
            <span class="release-source-notice__icon"><Icon name="GitBranch" size={22} /></span>
            <div>
              <span class="catalog-section-tag">02 / Source checkpoint</span>
              <h2>This tag has no published installers.</h2>
              <p>Friday {release.tag} is preserved as a source tag between packaged beta releases. Browse the tagged source or review every change from the previous version on GitHub.</p>
            </div>
          </div>
        </section>
      )
    }

    <section class="catalog-section release-links-section">
      <div class="shell">
        <header class="catalog-section__head">
          <div class="catalog-section__title">
            <span class="catalog-section-tag">03 / Source and history</span>
            <h2>Inspect the exact code.</h2>
          </div>
          <p class="catalog-section__aside">Every page stays anchored to the immutable Git tag and commit behind the version.</p>
        </header>
        <div class="release-source-links">
          <a href={release.sourceUrl} target="_blank" rel="noopener noreferrer">
            <Icon name="Github" size={18} />
            <span><strong>Tagged source</strong><small>{release.tag} at {shortCommit}</small></span>
            <Icon name="ArrowUpRight" size={16} />
          </a>
          {
            release.compareUrl ? (
              <a href={release.compareUrl} target="_blank" rel="noopener noreferrer">
                <Icon name="GitBranch" size={18} />
                <span><strong>Full comparison</strong><small>Review commits and changed files</small></span>
                <Icon name="ArrowUpRight" size={16} />
              </a>
            ) : (
              <a href="https://github.com/HaraldBregu/friday/tags" target="_blank" rel="noopener noreferrer">
                <Icon name="History" size={18} />
                <span><strong>All GitHub tags</strong><small>Browse the complete tag history</small></span>
                <Icon name="ArrowUpRight" size={16} />
              </a>
            )
          }
        </div>
      </div>
    </section>
  </article>
</ProductPageLayout>
