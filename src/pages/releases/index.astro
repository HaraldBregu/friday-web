---
import Icon from "../../components/Icon.astro";
import ProductPageHero from "../../components/ProductPageHero.astro";
import ProductPageLayout from "../../layouts/ProductPageLayout.astro";
import { formatReleaseDate, releasePath, releases } from "../../lib/releases";

const latestRelease = releases.find((release) => release.latest) ?? releases[0];
const downloadableReleases = releases.filter((release) => release.assets.length > 0).length;
---

<ProductPageLayout
  canonical="/releases"
  description="Friday release notes, tagged builds, source history, and desktop downloads for macOS, Windows, and Linux."
  title="Releases"
>
  <ProductPageHero
    accent="Friday"
    description="Every tagged version of Friday, with a concise change summary, source history, and the installers published for that build."
    eyebrow="Release archive"
    jumps={[
      { href: "#all-releases", icon: "History", label: "All releases" },
      { href: "https://github.com/HaraldBregu/friday/tags", icon: "Github", label: "GitHub tags" },
    ]}
    stats={[
      { value: latestRelease.tag, label: "Latest tag" },
      { value: releases.length, label: "Tagged builds" },
      { value: downloadableReleases, label: "Downloadable releases" },
    ]}
    statsLabel="Release archive summary"
    title="Friday releases."
  />

  <section class="catalog-section" id="all-releases">
    <div class="shell">
      <header class="catalog-section__head">
        <div class="catalog-section__title">
          <span class="catalog-section-tag">01 / Version history</span>
          <h2>From first beta to latest build.</h2>
        </div>
        <p class="catalog-section__aside">
          Release pages are generated from Friday's published tags. Download buttons appear only when a tagged build has matching GitHub release artifacts.
        </p>
      </header>

      <div class="release-grid">
        {
          releases.map((release, index) => (
            <article class:list={["release-card", release.latest && "is-latest"]}>
              <div class="release-card__topline">
                <span>{String(index + 1).padStart(2, "0")}</span>
                <span class:list={["release-status", release.latest && "is-latest"]}>
                  {release.latest ? "Latest" : release.stage}
                </span>
              </div>
              <div class="release-card__content">
                <p class="release-card__date">{formatReleaseDate(release.publishedAt, "short")}</p>
                <h2><a href={releasePath(release.tag)}>{release.name}</a></h2>
                <p>{release.summary}</p>
              </div>
              <div class="release-card__footer">
                <div>
                  <code>{release.tag}</code>
                  <span>{release.assets.length > 0 ? `${release.assets.length} downloads` : "Source tag"}</span>
                </div>
                <a href={releasePath(release.tag)}>
                  View release
                  <Icon name="ArrowRight" size={15} />
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</ProductPageLayout>
