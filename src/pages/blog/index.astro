---
import { getCollection } from "astro:content";
import Icon from "../../components/Icon.astro";
import Layout from "../../layouts/Layout.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const readingTime = (body: string) => Math.max(1, Math.ceil(body.trim().split(/\s+/).length / 220));
const slugFor = (id: string) => id.replace(/\.mdx?$/, "");
---

<Layout
  title="Blog"
  description="Product updates, engineering notes, and integration guides for Friday."
>
  <section class="section page-hero">
    <div class="shell section-heading">
      <p class="eyebrow">Blog</p>
      <h1>Notes for builders and operators.</h1>
      <p>Short updates on product decisions, workflow design, and integrations.</p>
    </div>
  </section>

  <section class="section section--compact">
    <div class="shell post-list">
      {
        posts.map((post) => {
          const slug = slugFor(post.id);

          return (
            <article class="post-card">
              <div class="post-card__meta">
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString("en", {
                    month: "short",
                    day: "numeric",
                    year: "numeric",
                  })}
                </time>
                <span>{readingTime(post.body)} min read</span>
              </div>
              <h2>
                <a href={`/blog/${slug}`}>{post.data.title}</a>
              </h2>
              <p>{post.data.description}</p>
              <div class="tag-list">
                {post.data.tags.map((tag) => <span>{tag}</span>)}
              </div>
              <a class="text-link" href={`/blog/${slug}`}>
                Read post
                <Icon name="ArrowRight" size={16} />
              </a>
            </article>
          );
        })
      }
    </div>
  </section>
</Layout>
