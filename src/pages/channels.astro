---
import CTASection from "../components/CTASection.astro";
import Icon from "../components/Icon.astro";
import channels from "../data/channels.json";
import Layout from "../layouts/Layout.astro";

const visible = channels.filter((c) => c.runtime !== "hidden");
const bundled = visible.filter((c) => c.runtime === "bundled");
const catalog = visible.filter((c) => c.runtime === "catalog");

const dmPolicyLabels: Record<string, string> = {
  allowlist: "Allowlist",
  pairing: "Pairing",
  open: "Open",
  deny: "Deny",
};
---

<Layout
  title="Channels"
  description="All 22 messaging channels supported by Friday — Telegram, Slack, Discord, WhatsApp, iMessage, Matrix, and more."
>
  <section class="section page-hero">
    <div class="shell section-heading">
      <p class="eyebrow">Channels</p>
      <h1>22 channels. Every one on your terms.</h1>
      <p>
        Configure account labels, allow-lists, DM policies, and delivery
        targets before Friday posts into any channel. Nothing leaves unless
        you say so.
      </p>
    </div>
  </section>

  <section class="section section--compact">
    <div class="shell">
      <div class="channel-explainer-row">
        <article class="channel-explainer-card">
          <Icon name="Zap" size={18} />
          <h3>Bundled runtime</h3>
          <p>Full inbound and outbound support built into Friday. Start without installing anything extra.</p>
        </article>
        <article class="channel-explainer-card">
          <Icon name="PlugZap" size={18} />
          <h3>Catalog channels</h3>
          <p>Configurable in Settings today. Inbound runtime coming as each channel is built out.</p>
        </article>
        <article class="channel-explainer-card">
          <Icon name="ShieldCheck" size={18} />
          <h3>DM policies</h3>
          <p>Four policy modes — Allowlist, Pairing, Open, or Deny — control who can reach the agent directly.</p>
        </article>
      </div>
    </div>
  </section>

  {bundled.length > 0 && (
    <section class="section section--compact">
      <div class="shell">
        <header class="channel-group-head">
          <h2>Bundled runtime</h2>
          <span>{bundled.length} channel</span>
        </header>
        <div class="channel-grid">
          {bundled.map((ch) => (
            <article class="channel-card channel-card--live">
              <div class="channel-card__header">
                <h3>{ch.name}</h3>
                <span class="badge badge--green">Live</span>
              </div>
              <p class="channel-card__desc">{ch.description}</p>
              <div class="channel-card__meta">
                <div class="meta-row">
                  <span class="meta-label">DM default</span>
                  <span class="meta-val">{dmPolicyLabels[ch.dmPolicy] ?? ch.dmPolicy}</span>
                </div>
                <div class="meta-row">
                  <span class="meta-label">Thread support</span>
                  <span class="meta-val">{ch.threadSupport ? "Yes" : "No"}</span>
                </div>
              </div>
              <div class="channel-card__fields">
                {ch.configFields.map((f) => <span>{f}</span>)}
              </div>
              {ch.docsUrl && (
                <a class="channel-card__link" href={ch.docsUrl} target="_blank" rel="noopener noreferrer">
                  Official docs <Icon name="ArrowRight" size={13} />
                </a>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section section--compact">
    <div class="shell">
      <header class="channel-group-head">
        <h2>Catalog channels</h2>
        <span>{catalog.length} channels</span>
      </header>
      <div class="channel-grid">
        {catalog.map((ch) => (
          <article class="channel-card">
            <div class="channel-card__header">
              <h3>{ch.name}</h3>
              <span class="badge badge--yellow">Catalog</span>
            </div>
            <p class="channel-card__desc">{ch.description}</p>
            <div class="channel-card__meta">
              <div class="meta-row">
                <span class="meta-label">DM default</span>
                <span class="meta-val">{dmPolicyLabels[ch.dmPolicy] ?? ch.dmPolicy}</span>
              </div>
              <div class="meta-row">
                <span class="meta-label">Thread support</span>
                <span class="meta-val">{ch.threadSupport ? "Yes" : "No"}</span>
              </div>
            </div>
            {ch.configFields.length > 0 && (
              <div class="channel-card__fields">
                {ch.configFields.map((f) => <span>{f}</span>)}
              </div>
            )}
            {ch.docsUrl && (
              <a class="channel-card__link" href={ch.docsUrl} target="_blank" rel="noopener noreferrer">
                Official docs <Icon name="ArrowRight" size={13} />
              </a>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--compact">
    <div class="shell">
      <header class="channel-group-head">
        <h2>Inbound flow</h2>
      </header>
      <div class="flow-steps">
        {[
          { step: "01", title: "Platform adapter", desc: "Receives the platform event and emits a channel inbound message." },
          { step: "02", title: "Ingress admission", desc: "Evaluates the security policy. Outcomes: dispatch, handled, observe-only, or drop." },
          { step: "03", title: "Agent dispatch", desc: "Allowed messages are forwarded to AgentService with the session key and reply target." },
          { step: "04", title: "Channel reply", desc: "The agent response routes back through the channel adapter to the original chat and thread." },
        ].map(({ step, title, desc }) => (
          <div class="flow-step">
            <span class="flow-step__num">{step}</span>
            <div>
              <strong>{title}</strong>
              <p>{desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTASection
    eyebrow="Add a runtime channel"
    title="Any platform with a bot API can become a channel."
    description="Implement a ChannelPlugin and ChannelAdapter, register in the registry, and follow the Telegram bundled runtime as the template."
  />
</Layout>

<style>
  .channel-explainer-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .channel-explainer-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .channel-explainer-card :global(svg) {
    color: var(--accent);
  }

  .channel-explainer-card h3 {
    font-size: 0.9rem;
    font-weight: 600;
    margin: 0;
  }

  .channel-explainer-card p {
    font-size: 0.82rem;
    color: var(--muted);
    margin: 0;
    line-height: 1.6;
  }

  .channel-group-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--line);
  }

  .channel-group-head h2 {
    font-size: 1rem;
    font-weight: 600;
    margin: 0;
    flex: 1;
  }

  .channel-group-head span {
    font-size: 0.75rem;
    color: var(--faint);
  }

  .channel-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 1rem;
  }

  .channel-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .channel-card--live {
    border-color: rgba(120, 212, 184, 0.25);
  }

  .channel-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .channel-card__header h3 {
    font-size: 0.95rem;
    font-weight: 600;
    margin: 0;
  }

  .channel-card__desc {
    font-size: 0.82rem;
    color: var(--muted);
    margin: 0;
    line-height: 1.6;
  }

  .channel-card__meta {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .meta-row {
    display: flex;
    gap: 0.5rem;
    font-size: 0.78rem;
  }

  .meta-label {
    color: var(--faint);
    min-width: 6.5rem;
  }

  .meta-val {
    color: var(--muted);
    font-weight: 500;
  }

  .channel-card__fields {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .channel-card__fields span {
    font-size: 0.7rem;
    background: var(--surface-strong);
    color: var(--muted);
    padding: 0.2em 0.5em;
    border-radius: 4px;
  }

  .channel-card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.78rem;
    color: var(--accent);
    text-decoration: none;
    margin-top: auto;
  }

  .channel-card__link:hover {
    text-decoration: underline;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.2em 0.55em;
    border-radius: 4px;
    flex-shrink: 0;
  }

  .badge--green  { background: rgba(120, 212, 184, 0.15); color: var(--green); }
  .badge--yellow { background: rgba(245, 191, 79, 0.15); color: var(--yellow); }

  .flow-steps {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .flow-step {
    display: flex;
    gap: 1.25rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--line);
  }

  .flow-step:last-child {
    border-bottom: none;
  }

  .flow-step__num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent);
    font-weight: 600;
    flex-shrink: 0;
    padding-top: 0.1rem;
  }

  .flow-step strong {
    display: block;
    font-size: 0.9rem;
    margin-bottom: 0.25rem;
  }

  .flow-step p {
    font-size: 0.82rem;
    color: var(--muted);
    margin: 0;
    line-height: 1.6;
  }

  @media (max-width: 640px) {
    .channel-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
