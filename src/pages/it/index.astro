---
import LandingPage from "../../components/LandingPage.astro";
import { getLocaleContent } from "../../i18n";
import { buildHomepageStructuredData } from "../../lib/structured-data";
import Layout from "../../layouts/Layout.astro";

const locale = "it";
const { friday, home, site } = getLocaleContent(locale);
const siteBaseUrl = Astro.site ?? new URL(site.url);
const structuredData = buildHomepageStructuredData({
  description: site.description,
  faqs: friday.faqs,
  featureNames: friday.landingFeatures.map((feature) => feature.title),
  locale,
  siteBaseUrl,
  tagline: site.tagline,
});
---

<Layout
  alternatePath="/"
  locale={locale}
  title={site.name}
  description={site.description}
  ogTitle={home.ogTitle}
  ogDescription={home.ogDescription}
  image="/og/home-it.png"
  structuredData={structuredData}
>
  <LandingPage locale={locale} />
</Layout>
