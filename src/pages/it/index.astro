---
import FridayLandingPage from "../../components/FridayLandingPage.astro";
import landing from "../../data/friday-landing-it.json";
import { getLocaleContent } from "../../i18n";
import { buildHomepageStructuredData } from "../../lib/structured-data";
import Layout from "../../layouts/Layout.astro";

const locale = "it";
const { site } = getLocaleContent(locale);
const title = "Friday: un assistente AI personale per il tuo desktop";
const description = "Friday è un assistente AI personale per il desktop: lavora con i file, cerca sul web, usa strumenti e rispetta le regole di autorizzazione che imposti tu.";
const siteBaseUrl = Astro.site ?? new URL(site.url);
const structuredData = buildHomepageStructuredData({
  description,
  featureNames: landing.capabilities.map((capability) => capability.label),
  locale,
  siteBaseUrl,
  tagline: site.tagline,
});
---

<Layout
  alternatePath="/"
  bodyClass="friday-landing-page"
  description={description}
  exactTitle
  footerVariant="landing"
  hideBackgroundEffects
  hideHeader
  image="/og/default.png"
  imageAlt="Friday, assistente AI personale per il desktop"
  locale={locale}
  ogDescription={description}
  ogTitle={title}
  structuredData={structuredData}
  title={title}
>
  <FridayLandingPage locale={locale} />
</Layout>
