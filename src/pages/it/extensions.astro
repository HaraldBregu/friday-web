---
import ExtensionsPage from "../../components/ExtensionsPage.astro";
import Layout from "../../layouts/Layout.astro";

const locale = "it";
const title = "Estensioni Friday — App mirate con il tuo agente AI";
const description = "Scopri le Estensioni Friday dedicate ai flussi di lavoro nel workspace e al disegno, collegate allo stesso agente AI, contesto e strumenti autorizzati.";
---

<Layout
  alternatePath="/extensions"
  bodyClass="friday-landing-page"
  description={description}
  exactTitle
  footerVariant="landing"
  hideBackgroundEffects
  hideHeader
  image="/og/default.png"
  imageAlt="Interfacce Friday Extensions per workspace e disegno"
  locale={locale}
  ogDescription={description}
  ogTitle={title}
  title={title}
>
  <ExtensionsPage locale={locale} />
</Layout>
