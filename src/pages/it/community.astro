---
import CTASection from "../../components/CTASection.astro";
import Icon from "../../components/Icon.astro";
import socialLinks from "../../data/social-links.json";
import { getLocaleContent } from "../../i18n";
import Layout from "../../layouts/Layout.astro";

const locale = "it";
const { communityPage } = getLocaleContent(locale);
---

<Layout
  alternatePath="/community"
  locale={locale}
  title={communityPage.title}
  description={communityPage.description}
  image="/og/community.png"
>
  <section class="section page-hero">
    <div class="shell section-heading">
      <p class="eyebrow">{communityPage.eyebrow}</p>
      <h1>{communityPage.heading}</h1>
      <p>{communityPage.intro}</p>
    </div>
  </section>

  <section class="section section--compact">
    <div class="shell mission-grid">
      {
        communityPage.cards.map((card) => (
          <article>
            <Icon name={card.icon} />
            <h2>{card.title}</h2>
            <p>{card.description}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section section--muted" id="contribute">
    <div class="shell split-heading">
      <div>
        <p class="eyebrow">{communityPage.joinEyebrow}</p>
        <h2>{communityPage.joinTitle}</h2>
      </div>
    </div>
    <div class="shell community-links">
      {
        socialLinks.map((link) => (
          <a class="community-link" href={link.url}>
            <Icon name={link.icon} />
            <span>{link.label}</span>
          </a>
        ))
      }
    </div>
  </section>

  <CTASection
    locale={locale}
    eyebrow={communityPage.ctaEyebrow}
    title={communityPage.ctaTitle}
    description={communityPage.ctaDescription}
  />
</Layout>
