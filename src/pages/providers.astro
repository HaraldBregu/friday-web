---
import CTASection from "../components/CTASection.astro";
import Icon from "../components/Icon.astro";
import providers from "../data/providers.json";
import Layout from "../layouts/Layout.astro";
import "../styles/friday-landing.css";
import "../styles/catalog-pages.css";

const capabilityColors: Record<string, string> = {
  Assistant: "cap--blue",
  "Speech-to-Text": "cap--green",
  "Text-to-Speech": "cap--green",
  "Text-to-Image": "cap--purple",
  "Text-to-Video": "cap--yellow",
  "Music / Audio": "cap--pink",
};

const allCapabilities = [...new Set(providers.flatMap((provider) => provider.capabilities))].sort();
const providerGroups = [
  {
    id: "assistant",
    label: "Assistant",
    title: "The reasoning layer.",
    description: "Choose the provider behind conversation, planning, tool selection, and multi-step agent work.",
    icon: "Bot",
    items: providers.filter((provider) => provider.capabilities.includes("Assistant")),
  },
  {
    id: "voice",
    label: "Voice",
    title: "Listen and speak.",
    description: "Configure transcription and text-to-speech independently so each voice task uses the right service.",
    icon: "Mic",
    items: providers.filter((provider) =>
      provider.capabilities.some((capability) => ["Speech-to-Text", "Text-to-Speech"].includes(capability))
    ),
  },
  {
    id: "image",
    label: "Image",
    title: "Create visual work.",
    description: "Route image generation to the provider that fits the style, quality, speed, and cost you need.",
    icon: "Image",
    items: providers.filter((provider) => provider.capabilities.includes("Text-to-Image")),
  },
  {
    id: "video-audio",
    label: "Video & audio",
    title: "Add motion and sound.",
    description: "Use specialist media providers for generated video, music, sound effects, and richer creative output.",
    icon: "Video",
    items: providers.filter((provider) =>
      provider.capabilities.includes("Text-to-Video") || provider.capabilities.includes("Music / Audio")
    ),
  },
];
---

<Layout
  bodyClass="catalog-product-page"
  description="Friday lets you bring your own AI provider keys and choose providers by capability."
  footerVariant="landing"
  headerVariant="landing"
  hideBackgroundEffects
  image="/og/providers.png"
  title="AI Providers"
  wide
>
  <section class="catalog-hero">
    <div class="shell catalog-hero__inner">
      <p class="catalog-eyebrow">AI Providers</p>
      <h1>Bring your own <em>AI.</em></h1>
      <p class="catalog-hero__lede">
        Add your own API keys and choose the provider behind each capability. Mix models freely while credentials
        stay in your local Friday settings.
      </p>

      <nav class="catalog-jump" aria-label="Provider categories">
        {providerGroups.map((group) => (
          <a href={`#${group.id}`}>
            <Icon name={group.icon} size={15} />
            {group.label}
          </a>
        ))}
      </nav>

      <div class="catalog-summary" aria-label="Provider catalog summary">
        <div><strong>{providers.length}</strong><span>Available providers</span></div>
        <div><strong>{allCapabilities.length}</strong><span>AI capabilities</span></div>
        <div><strong>Local</strong><span>Credential storage</span></div>
      </div>
    </div>
  </section>

  {providerGroups.map((group, groupIndex) => (
    <section class:list={["catalog-section", groupIndex % 2 === 1 && "is-tinted"]} id={group.id}>
      <div class="shell">
        <header class="catalog-section__head">
          <div class="catalog-section__title">
            <span class="catalog-section-tag">{String(groupIndex + 1).padStart(2, "0")} / {group.label}</span>
            <h2>{group.title}</h2>
          </div>
          <p class="catalog-section__aside">{group.description}</p>
        </header>

        <div class="provider-grid">
          {group.items.map((provider, index) => (
            <article class="provider-card">
              <div class="provider-card__top">
                <span class="provider-card__number">{String(index + 1).padStart(2, "0")}</span>
                <span class="provider-card__icon"><Icon name={group.icon} size={17} /></span>
              </div>
              <h3>{provider.name}</h3>
              <p class="provider-card__note">{provider.note}</p>
              <div class="provider-card__caps">
                {provider.capabilities.map((capability) => (
                  <span class={`cap ${capabilityColors[capability] ?? "cap--muted"}`}>{capability}</span>
                ))}
              </div>
              <div class="provider-card__meta">
                {provider.envVar ? (
                  <code class="env-badge">{provider.envVar}</code>
                ) : (
                  <span class="env-badge env-badge--none">No official API</span>
                )}
                {provider.docsUrl && (
                  <a class="provider-card__link" href={provider.docsUrl} target="_blank" rel="noopener noreferrer">
                    Official docs
                    <Icon name="ArrowRight" size={13} />
                  </a>
                )}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  ))}

  <CTASection
    eyebrow="Provider choice"
    title="One assistant. Your provider stack."
    description="Mix providers for quality, cost, and speed while keeping every provider key in local settings."
  />
</Layout>
