---
import CTASection from "../components/CTASection.astro";
import Icon from "../components/Icon.astro";
import providers from "../data/providers.json";
import Layout from "../layouts/Layout.astro";

const capabilityColors: Record<string, string> = {
  "Assistant": "cap--blue",
  "Speech-to-Text": "cap--green",
  "Text-to-Speech": "cap--green",
  "Text-to-Image": "cap--purple",
  "Text-to-Video": "cap--yellow",
  "Music / Audio": "cap--pink",
};

const allCapabilities = [...new Set(providers.flatMap((p) => p.capabilities))].sort();

const assistantProviders = providers.filter((p) => p.capabilities.includes("Assistant"));
const voiceProviders = providers.filter((p) =>
  p.capabilities.some((c) => ["Speech-to-Text", "Text-to-Speech"].includes(c))
);
const imageProviders = providers.filter((p) => p.capabilities.includes("Text-to-Image"));
const futureProviders = providers.filter((p) => p.capabilities.includes("Text-to-Video") || p.capabilities.includes("Music / Audio"));
---

<Layout
  title="AI Providers"
  description="Friday lets you bring your own AI provider keys and choose providers by capability."
>
  <section class="section page-hero">
    <div class="shell section-heading">
      <p class="eyebrow">AI Providers</p>
      <h1>Bring your own AI.</h1>
      <p>
        Add your own API keys and choose the provider and model behind each
        capability. Credentials stay local.
      </p>
    </div>
  </section>

  <section class="section section--compact">
    <div class="shell">
      <div class="cap-legend">
        {allCapabilities.map((cap) => (
          <span class={`cap ${capabilityColors[cap] ?? "cap--muted"}`}>{cap}</span>
        ))}
      </div>
    </div>
  </section>

  {[
    { label: "Assistant", icon: "Bot", items: assistantProviders },
    { label: "Voice", icon: "Mic", items: voiceProviders },
    { label: "Image", icon: "Image", items: imageProviders },
    { label: "Video & audio", icon: "Video", items: futureProviders },
  ].map(({ label, icon, items }) => (
    <section class="section section--compact">
      <div class="shell">
        <header class="provider-group-head">
          <Icon name={icon} size={18} />
          <h2>{label}</h2>
          <span>{items.length} providers</span>
        </header>
        <div class="provider-grid">
          {items.map((p) => (
            <article class="provider-card">
              <div class="provider-card__top">
                <h3>{p.name}</h3>
                {p.envVar ? (
                  <code class="env-badge">{p.envVar}</code>
                ) : (
                  <span class="env-badge env-badge--none">No official API</span>
                )}
              </div>
              <div class="provider-card__caps">
                {p.capabilities.map((cap) => (
                  <span class={`cap cap--sm ${capabilityColors[cap] ?? "cap--muted"}`}>{cap}</span>
                ))}
              </div>
              {p.models.length > 0 && (
                <p class="provider-card__models">{p.models.join(" · ")}</p>
              )}
              <p class="provider-card__note">{p.note}</p>
              {p.docsUrl && (
                <a class="provider-card__link" href={p.docsUrl} target="_blank" rel="noopener noreferrer">
                  Official docs
                  <Icon name="ArrowRight" size={13} />
                </a>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>
  ))}

  <CTASection
    eyebrow="Provider choice"
    title="Each capability can use a different provider."
    description="Mix providers for quality, cost, and speed while keeping provider keys in local settings."
  />
</Layout>

<style>
  .cap-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .cap {
    display: inline-flex;
    align-items: center;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.25em 0.6em;
    border-radius: 4px;
  }

  .cap--sm {
    font-size: 0.65rem;
  }

  .cap--blue   { background: rgba(99, 155, 255, 0.14); color: #7eb3ff; }
  .cap--green  { background: rgba(120, 212, 184, 0.14); color: var(--green); }
  .cap--purple { background: rgba(185, 166, 255, 0.14); color: var(--purple); }
  .cap--yellow { background: rgba(245, 191, 79, 0.14); color: var(--yellow); }
  .cap--accent { background: var(--accent-soft); color: var(--accent); }
  .cap--pink   { background: rgba(255, 160, 190, 0.14); color: #ffb3cc; }
  .cap--muted  { background: var(--surface-strong); color: var(--faint); }

  .provider-group-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--line);
  }

  .provider-group-head h2 {
    font-size: 1rem;
    font-weight: 600;
    margin: 0;
    flex: 1;
  }

  .provider-group-head span {
    font-size: 0.75rem;
    color: var(--faint);
  }

  .provider-group-head :global(svg) {
    color: var(--accent);
  }

  .provider-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1rem;
  }

  .provider-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .provider-card__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .provider-card__top h3 {
    font-size: 0.95rem;
    font-weight: 600;
    margin: 0;
  }

  .env-badge {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    background: var(--surface-strong);
    color: var(--muted);
    padding: 0.2em 0.45em;
    border-radius: 4px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .env-badge--none {
    font-family: var(--font-sans);
    font-style: italic;
    color: var(--faint);
  }

  .provider-card__caps {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .provider-card__models {
    font-size: 0.78rem;
    color: var(--muted);
    margin: 0;
    line-height: 1.5;
  }

  .provider-card__note {
    font-size: 0.78rem;
    color: var(--faint);
    margin: 0;
    line-height: 1.5;
  }

  .provider-card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.78rem;
    color: var(--accent);
    text-decoration: none;
    margin-top: auto;
  }

  .provider-card__link:hover {
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .provider-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
